# ============================================================================
# inSite Assurance — Backend Environment Variables (.env)
# Copy this file to `server/.env` and fill in your credentials
# ============================================================================

PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ----------------------------------------------------------------------------
# 1. PostgreSQL Database Connection
# ----------------------------------------------------------------------------
# Option A — Local PostgreSQL 18 (Recommended for daily local dev & offline work):
DATABASE_URL="postgresql://postgres:YOUR_LOCAL_PG_PASSWORD@localhost:5432/insite_assurance?schema=public"

# Option B — Neon Serverless Postgres (For shared staging / Render production):
# DATABASE_URL="postgresql://neondb_owner:PASSWORD@ep-cool-name-123456-pooler.eu-central-1.aws.neon.tech/insite_assurance?sslmode=require"

# ----------------------------------------------------------------------------
# 2. Authentication Secrets
# ----------------------------------------------------------------------------
JWT_SECRET="insite-assurance-dev-jwt-secret-change-in-production-2026"
JWT_EXPIRES_IN="7d"

# ----------------------------------------------------------------------------
# 3. Azure OpenAI Service (Provisioned Company Instance)
# ----------------------------------------------------------------------------
AZURE_OPENAI_ENDPOINT="https://your-company-resource.openai.azure.com/"
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_API_VERSION="2024-10-21"
AZURE_OPENAI_GPT_DEPLOYMENT="gpt-4o"
AZURE_OPENAI_WHISPER_DEPLOYMENT="whisper"

# ----------------------------------------------------------------------------
# 4. S3-Compatible Object Storage (Cloudflare R2 or AWS S3)
# ----------------------------------------------------------------------------
S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_BUCKET_NAME="insite-assurance-evidence"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""

