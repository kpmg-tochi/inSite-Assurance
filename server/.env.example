# ============================================================================
# InSite Assurance — Backend Environment Variables (.env)
# Copy this file to `server/.env` and fill in your credentials
# ============================================================================

PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ----------------------------------------------------------------------------
# 1. PostgreSQL Database Connection
# ----------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:YOUR_LOCAL_PG_PASSWORD@localhost:5432/insite_assurance?schema=public"

# ----------------------------------------------------------------------------
# 2. Authentication Secrets
# ----------------------------------------------------------------------------
JWT_SECRET="insite-assurance-dev-jwt-secret-change-in-production-2026"
JWT_EXPIRES_IN="7d"

# ----------------------------------------------------------------------------
# 3. Company Azure OpenAI Sandbox (GPT-4o Reasoning, Vision & Reconciliation)
# ----------------------------------------------------------------------------
AZURE_OPENAI_ENDPOINT="https://your-company-resource.openai.azure.com/"
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_API_VERSION="2024-10-21"
AZURE_OPENAI_GPT_DEPLOYMENT="gpt-4.1"
AzureOpenAI__MaxTokensPerRequest=12000
AzureOpenAI__MaxOutputTokens=6000
AzureOpenAI__MaxRetries=2
AzureOpenAI__TimeoutSeconds=180

# ----------------------------------------------------------------------------
# 4. Standalone Whisper Speech-to-Text (OpenAI API / Groq / Standalone Endpoint)
# ----------------------------------------------------------------------------
WHISPER_API_KEY=""
# Optional custom baseURL (e.g., https://api.groq.com/openai/v1 for whisper-large-v3-turbo, or leave blank for OpenAI)
WHISPER_BASE_URL=""
WHISPER_MODEL="whisper-1"

# ----------------------------------------------------------------------------
# 5. S3-Compatible Object Storage (Cloudflare R2 or AWS S3)
# ----------------------------------------------------------------------------
S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_BUCKET_NAME="insite-assurance-evidence"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""
