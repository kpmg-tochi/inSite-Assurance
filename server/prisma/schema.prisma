generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// ENUMS
// ============================================================================

enum TenantStatus {
  ACTIVE
  SUSPENDED
  TRIAL
}

enum RoleSurface {
  WEB
  MOBILE
  BOTH
}

enum FieldPersonaType {
  INDEPENDENT_VERIFIER
  NONE
}

enum OrganizationCategory {
  ADVISORY_MONITOR
  FINANCIER_LENDER
  CONTRACTOR
  CLIENT_OWNER
  GOVERNMENT_MDA
  OTHER
}

// Redesign R7a: categories follow the programme flow (labels in shared PERMISSION_CATEGORY_META).
enum PermissionCategory {
  TENANT_ADMIN
  FORMS_FACILITIES
  PORTFOLIO_PROJECTS
  SCOPE_SPRINTS
  CONTRACT_KICKOFF
  VISITS_FINDINGS
  PAYMENTS
  COMPLETION_CLOSURE
}

// FieldPersonaType replaces static IndependenceTier enum on Role & FieldAgentSession

// Redesign: linear corridors were removed (sites are radial or perimeter).
enum GeofenceMode {
  RADIAL
  PERIMETER
}

// Server evaluation of a position against the project geofence and its tolerance band (Phase 6).
enum GeofenceStatus {
  INSIDE
  WITHIN_TOLERANCE
  OUTSIDE
}

// How organisation fields take input, per tenant (decision E).
enum OrgInputMode {
  FREE_TEXT
  DIRECTORY
  BOTH
}

// Project lifecycle (decision C). ACTIVE never returns to DRAFT.
enum ProjectStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum EvidenceLogStatus {
  REGISTERED
  FLAGGED_INTEGRITY
}

// Phase 7: process engine
enum DocumentRequirementMode {
  REQUIRED_AT_CREATION
  OPTIONAL_AT_CREATION
  DISABLED
}

enum StandardCategory {
  MATERIAL_QUALITY
  EXECUTION_METHOD
  TESTING_TOLERANCE
  SAFETY_ENVIRONMENT
  GENERAL_SPECIFICATION
}

enum NeedsAssessmentDocType {
  COMMUNITY_NEEDS_ASSESSMENT
  FEASIBILITY_STUDY
  ENVIRONMENTAL_SOCIAL_IMPACT
  STAKEHOLDER_REQUIREMENTS
  TECHNICAL_BASELINE
}

enum ApprovalChainType {
  REPORT
  // Phase 13
  CONTRACT_DEFAULT
}

enum ApprovalSubjectType {
  // Phase 13
  CONTRACT_DEFAULT_CASE
  // Redesign R4
  VISIT_SUBMISSION
}

enum ApprovalDecision {
  APPROVE
  RETURN
  REJECT
}

enum MediaType {
  SITE_PHOTO
  VOICE_NOTE
  WAYBILL_DOCUMENT
  LAB_CUBE_TEST_CERT
  MILL_CERTIFICATE
  BOQ_SPREADSHEET
  IDENTITY_DOCUMENT
  IDENTITY_SELFIE
  PROJECT_DOCUMENT
}

enum AuditActorType {
  WEB_USER
  FIELD_AGENT
  AI_SYSTEM
  SYSTEM
}

enum AuditActionType {
  TENANT_CREATED
  TENANT_BRANDING_UPDATED
  ROLE_CREATED
  ROLE_UPDATED
  ROLE_DELETED
  USER_PROJECT_ASSIGNED
  PROJECT_CREATED
  BASELINE_UPDATED
  BOQ_UPLOADED
  FIELD_AGENT_JOINED
  FIELD_SESSION_STATUS_UPDATED
  EVIDENCE_EXTRACTED
  EVIDENCE_CONFIRMED
  EVIDENCE_FLAGGED_INTEGRITY
  INCIDENT_REPORT_SUBMITTED
  INCIDENT_STATUS_UPDATED
  PUSH_TOKEN_REGISTERED
  USER_CREATED
  USER_UPDATED
  USER_DEACTIVATED
  LOGIN_FAILED_LOCKOUT
  TENANT_SETTINGS_UPDATED
  CAPTURE_REGISTERED
  CAPTURE_FLAGGED_INTEGRITY
  DEVICE_KEY_REGISTERED
  MOBILE_USER_SIGNED_IN
  MOBILE_DEVICE_REVOKED
  ORGANIZATION_CREATED
  ORGANIZATION_UPDATED
  PROJECT_DRAFT_CREATED
  PROJECT_SETUP_STEP_SAVED
  PROJECT_ACTIVATED
  PROJECT_ARCHIVED
  PROJECT_CONTRACTOR_ADDED
  PROJECT_CONTRACTOR_REMOVED
  BOQ_REVISED
  PROJECT_DRAFT_DELETED
  WORKFLOW_TEMPLATE_SAVED
  PROJECT_PROCESS_CONFIG_UPDATED
  PROJECT_STANDARD_CREATED
  PROJECT_STANDARD_UPDATED
  PROJECT_STANDARD_DELETED
  NEEDS_ASSESSMENT_UPLOADED
  NEEDS_ASSESSMENT_DELETED
  APPROVAL_STEP_ACTIONED
  // Phase 10 (R1d: the response is recorded by staff, no public link)
  HANDOVER_RECORDED
  HANDOVER_REVIEWED
  PROJECT_PHASE_CHANGED
  RETENTION_WITHHELD
  DEFECT_TICKET_RAISED
  DEFECT_TICKET_UPDATED
  DEFECT_TICKET_CLOSED
  RETENTION_RELEASED
  // Phase 11
  PROJECT_TYPE_SAVED
  PROJECT_TYPE_APPLIED
  ORGANIZATION_HIERARCHY_CHANGED
  TERMINOLOGY_UPDATED
  // Phase 14 (findings)
  INSPECTION_FINDING_RAISED
  INSPECTION_FINDING_RESOLVED
  // Phase 13
  DOCUMENT_UPLOADED
  DOCUMENT_VERSIONED
  DOCUMENT_SIGNED
  DOCUMENT_ARCHIVED
  DOCUMENT_TYPE_SAVED
  CONTRACT_DETAILS_SAVED
  MILESTONE_COMPLETED
  MILESTONE_WAIVED
  MILESTONE_DATES_RECOMPUTED
  KICKOFF_SCHEDULED
  KICKOFF_NOTICE_SENT
  KICKOFF_HELD
  DEFAULT_CASE_OPENED
  DEFAULT_CASE_REVIEWED
  DEFAULT_CASE_DECIDED
  CONTRACTOR_TERMINATED
  // Phase 15
  COC_DRAFTED
  COC_SIGNED
  COC_ISSUED
  COC_REVOKED
  HANDOVER_CERTIFICATE_ISSUED
  CLOSURE_ITEM_COMPLETED
  CLOSURE_ITEM_WAIVED
  CLOSURE_AUDIT_SIGNED
  CONTRACTOR_RATED
  LESSON_PUBLISHED
  CLOSURE_PACK_EXPORTED
  // Redesign R1b: payments are made outside the platform and recorded here
  PAYMENT_RECORDED
  PAYMENT_VOIDED
  // Redesign R2: facilities, scope and sprints
  FACILITY_SAVED
  SCOPE_UPDATED
  SPRINTS_SAVED
  SCOPE_IMPORTED
  // UBEC IRL: bulk project register import
  PROJECT_REGISTER_IMPORTED
  // Client demo updates C3: project lots
  PROJECT_LOT_CREATED
  // Redesign R3: form library
  FORM_COMPONENT_SAVED
  // Redesign R4: visits
  VISITS_GENERATED
  VISIT_CREATED
  VISIT_PUBLISHED
  VISIT_UPDATED
  VISIT_CANCELLED
  VISIT_FORM_REBUILT
  VISIT_OFFICERS_SAVED
  VISIT_RESPONDED
  VISIT_DATE_DECIDED
  VISIT_CHECKED_IN
  VISIT_SUBMITTED
  VISIT_MISSED
  SITE_LOG_ADDED
  SITE_LOG_HIDDEN
  VISIT_REVIEWED
  FINDING_ESCALATED
  FINDINGS_SUMMARY_SENT
  SPRINT_VERIFIED
}

// Phase 11: which organisation an approval step actor must belong to (ANY = Phase 7 behaviour).
enum ApprovalOrganizationScope {
  ANY
  PROJECT_OWNER
  PROJECT_OWNER_OR_ANCESTOR
  FUNDER
}

enum BeneficiaryType {
  SCHOOL
  COMMUNITY
  INSTITUTION
  OTHER
}

// Phase 10: where an ACTIVE project is in its life (ProjectStatus is unchanged).
enum ConstructionPhase {
  ACTIVE_CONSTRUCTION
  HANDOVER_IN_PROGRESS
  RETENTION_PERIOD
  COMPLETED_CLOSED
}

enum HandoverStakeholderType {
  COMMUNITY_REPRESENTATIVE
  CLIENT_STAFF
  END_USER
  OTHER
}

enum HandoverDecision {
  ACCEPTED
  ACCEPTED_WITH_SNAGS
  REJECTED
}

enum DefectSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum DefectTicketStatus {
  OPEN
  ASSIGNED
  RECTIFIED_PENDING_VERIFICATION
  VERIFIED_CLOSED
  REJECTED_NOT_A_DEFECT
}

// Phase 8: jobs and outbound messages (roster and attendance removed in R1e, cadence in R5f)

enum JobRunStatus {
  RUNNING
  DONE
  FAILED
}

enum OutboundChannel {
  EMAIL
  SMS
  PUSH
}

enum OutboundMessageStatus {
  QUEUED
  SENT
  FAILED
}

enum MobileNotificationType {
  // Phase 10
  DEFECT_UPDATE
  // Redesign R4
  VISIT_ASSIGNED
  VISIT_CHANGED
  VISIT_REMINDER
  VISIT_RETURNED
  VISIT_APPROVED
  // UBEC IRL: early-warning alerts (stalled, site update overdue) for the project's field officers
  PROJECT_ALERT
}

enum NotificationActionType {
  NONE
  // Phase 10
  OPEN_DEFECTS
  // Redesign R4
  OPEN_VISIT
}

// ============================================================================
// MODELS
// ============================================================================

// ============================================================================
// MULTI-TENANCY & RELATIONAL RBAC MODELS
// ============================================================================

model Tenant {
  id                               String         @id @default(uuid()) @db.Uuid
  name                             String
  slug                             String         @unique
  status                           TenantStatus   @default(ACTIVE)
  defaultCurrency                  String         @default("NGN")
  timezone                         String         @default("Africa/Lagos")
  brandingConfig                   Json           @default("{}")
  // Phase 6 settings
  organizationInputMode            OrgInputMode   @default(BOTH)
  enabledGeofenceModes             GeofenceMode[] @default([RADIAL, PERIMETER])
  defaultGeofenceToleranceMeters   Int            @default(100)
  // Redesign: pre-fills a new radial boundary and the workbook GPS boundary; projects set their own radius.
  defaultGeofenceRadiusMeters      Int            @default(150)
  // Redesign R4 (D-R4.15): ± working days an officer may move a visit from its original date.
  visitRescheduleToleranceWorkdays Int            @default(2)
  // Phase 11: tenant wording per terminology key ({ key: { singular, plural? } }); keys fixed in shared.
  terminologyLabels                Json           @default("{}")
  // Phase 15: contractor rating criteria [{ key, label, description }]; empty = the defaults.
  ratingCriteriaJson               Json           @default("[]")
  // Client demo updates D5: the month the fiscal year starts (1 = January). Periods and the
  // intervention year rule follow it.
  fiscalYearStartMonth             Int            @default(1)
  createdAt                        DateTime       @default(now())
  updatedAt                        DateTime       @updatedAt

  organizations      Organization[]
  roles              Role[]
  users              User[]
  projects           Project[]
  auditLogs          AuditLog[]
  workflowTemplates  WorkflowTemplate[]
  outboundMessages   OutboundMessage[]
  projectTypes       ProjectType[]
  lessonsLearned     LessonLearned[]
  kpiSnapshots       KpiSnapshot[] // Phase 16
  regions            Region[]
  projectLots        ProjectLot[] // Client demo updates C3
  // Phase 13
  documentTypes      DocumentType[]
  // Redesign R2a
  facilities         Facility[]
  // Redesign R3
  formSections       FormSection[]
  facilitySubForms   FacilitySubForm[]
  visitFormTemplates VisitFormTemplate[]
  visitFormSnapshots VisitFormSnapshot[]

  @@map("tenants")
}

model Permission {
  id          String             @id @default(uuid()) @db.Uuid
  key         String             @unique
  name        String
  description String
  category    PermissionCategory
  surface     RoleSurface        @default(WEB)
  createdAt   DateTime           @default(now())

  rolePermissions RolePermission[]

  @@index([category])
  @@map("permissions")
}

model Role {
  id               String           @id @default(uuid()) @db.Uuid
  tenantId         String           @db.Uuid
  name             String
  code             String
  description      String?
  surface          RoleSurface      @default(WEB)
  // Redesign R1d: mobile roles are provisioned accounts only (R5f removed the contractor persona).
  fieldPersonaType FieldPersonaType @default(NONE)
  assuranceWeight  Float            @default(1.0)
  isSystemDefault  Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  users           User[]              @relation("UserMainRole")
  mobileUsers     User[]              @relation("UserMobileRole")
  fieldSessions   FieldAgentSession[]

  @@unique([tenantId, code])
  @@index([tenantId, surface])
  @@map("roles")
}

model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  roleId       String   @db.Uuid
  permissionId String   @db.Uuid
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

// Organisation directory (Phase 6). Tags say which parts an organisation can play; the same firm
// may be a contractor on one project and a client on another. Name is unique per tenant
// (case-insensitive raw index from Phase 2).
model Organization {
  id                   String                 @id @default(uuid()) @db.Uuid
  tenantId             String                 @db.Uuid
  name                 String
  categories           OrganizationCategory[] @default([])
  registrationNumber   String?
  contactEmail         String?
  contactPhone         String?
  isArchived           Boolean                @default(false)
  // Phase 11: hierarchy (flagship -> subsidiaries), up to 5 levels; cycles refused by the service.
  parentOrganizationId String?                @db.Uuid
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parentOrganization Organization?       @relation("OrganizationHierarchy", fields: [parentOrganizationId], references: [id], onDelete: Restrict)
  childOrganizations Organization[]      @relation("OrganizationHierarchy")
  users              User[]
  monitoredProjects  Project[]           @relation("MonitorOrganization")
  lenderProjects     Project[]           @relation("LenderOrganization")
  ownedProjects      Project[]           @relation("OwningOrganization")
  projectContractors ProjectContractor[]

  @@index([tenantId])
  @@index([parentOrganizationId])
}

model User {
  id                   String    @id @default(uuid()) @db.Uuid
  tenantId             String    @db.Uuid
  email                String    @unique
  passwordHash         String
  fullName             String
  isPlatformSuperAdmin Boolean   @default(false)
  roleId               String    @db.Uuid
  // Optional pre-provisioned mobile role (surface MOBILE or BOTH).
  mobileRoleId         String?   @db.Uuid
  phoneNumber          String?
  organizationId       String    @db.Uuid
  isActive             Boolean   @default(true)
  mustChangePassword   Boolean   @default(false)
  tokenVersion         Int       @default(0)
  failedLoginCount     Int       @default(0)
  lockedUntil          DateTime?
  lastLoginAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  tenant             Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  notificationReads  WebNotificationRead[]
  role               Role                    @relation("UserMainRole", fields: [roleId], references: [id], onDelete: Restrict)
  mobileRole         Role?                   @relation("UserMobileRole", fields: [mobileRoleId], references: [id], onDelete: SetNull)
  mobileDevices      MobileDevice[]
  fieldSessions      FieldAgentSession[]
  organization       Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  projectAssignments UserProjectAssignment[]
  pushTokens         PushToken[]
  approvalActions    ApprovalAction[]
  visitAssignments   VisitAssignee[] // Redesign R4

  @@index([tenantId])
  @@index([organizationId])
  @@index([roleId])
  @@index([mobileRoleId])
}

model UserProjectAssignment {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  projectId String   @db.Uuid
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([userId])
  @@index([projectId])
  @@map("user_project_assignments")
}

/// Client demo updates C3: a lot is a category of project within an intervention year, numbered in
/// order per year; its projects are its batches. Codes are assigned in a per-tenant advisory lock.
model ProjectLot {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @db.Uuid
  interventionYear Int
  number           Int
  title            String
  createdByUserId  String?  @db.Uuid
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projects Project[]

  @@unique([tenantId, interventionYear, number])
  @@index([tenantId, interventionYear])
  @@map("project_lots")
}

model Project {
  id                      String        @id @default(uuid()) @db.Uuid
  tenantId                String        @db.Uuid
  name                    String
  codePrefix              String // e.g., "LKK-402", unique per tenant
  // Lifecycle (Phase 6). Drafts are visible only in the wizard and the Drafts tab.
  status                  ProjectStatus @default(DRAFT)
  // Per wizard step: { completedAt, completedByUserId }; plus team options.
  setupState              Json          @default("{}")
  createdByUserId         String?       @db.Uuid
  activatedAt             DateTime?
  activatedByUserId       String?       @db.Uuid
  archivedAt              DateTime?
  // Nullable while the project is a draft; activation requires them.
  stateLocation           String? // e.g., "Lagos State"
  lgaLocation             String?
  description             String?
  totalBudgetNgn          Decimal?      @db.Decimal(18, 2)
  disbursedToDateNgn      Decimal       @default(0) @db.Decimal(18, 2)
  certifiedProgressPct    Decimal       @default(0) @db.Decimal(5, 2)
  // UBEC IRL (2026-11-25): register fields. Intervention year = the budget year the project is funded from;
  // funding source = free text with shared suggestions (FUNDING_SOURCE_SUGGESTIONS).
  interventionYear        Int?
  fundingSource           String?
  // The client's own project ID (e.g. UBEC's), kept alongside our code; unique per tenant when set.
  externalReference       String?
  // Bulk register import: set on every imported project. Projects already under way are imported live
  // with the reported % complete (shown until their scope is added) and the status the client reported.
  importedAt              DateTime?
  // Client demo updates (wave 1). C1: national reference codes (NIGERIA_STATES / NIGERIA_LGAS); the
  // stateLocation / lgaLocation text is still written for older screens. C4: FUNDING_SOURCES code
  // (fundingSource keeps the text). C3: the lot and batch the code {year}-LOT-{lot}-BATCH-{batch} names.
  stateCode               String?
  lgaCode                 String?
  fundingSourceCode       String?
  lotId                   String?       @db.Uuid
  batchNumber             Int?
  importedProgressPct     Decimal?      @db.Decimal(5, 2)
  importedStatus          String?
  workdayStartTime        String        @default("08:00")
  workdayEndTime          String        @default("17:00")
  // IANA zone of the project (dates, deadlines, visit days). Defaults to the tenant zone.
  timezone                String        @default("Africa/Lagos")
  geofenceMode            GeofenceMode?
  geofenceGeoJson         Json? // ProjectGeofence: radial or perimeter
  // Tolerance band outside the boundary; null uses Tenant.defaultGeofenceToleranceMeters.
  geofenceToleranceMeters Int?

  // Working week: ISO weekdays (1 = Monday). Visit dates, tolerances and deadlines count these
  // (Phase 8 column; redesign R5f deleted the reporting cadence around it).
  workWeekDays                    Int[] @default([1, 2, 3, 4, 5, 6])
  // Days before a contract milestone is due that reminders go out (Phase 8 name; the roster went in R1e).
  mobilizationReminderOffsetsDays Int[] @default([7, 3, 1])

  // Phase 9 schedule dates (YYYY-MM-DD in the project zone). Redesign R2d: planned start and end follow
  // the first and last sprint; originalPlannedEndDate is kept once the project is live.
  plannedStartDate           String?
  plannedEndDate             String?
  originalPlannedEndDate     String?
  actualStartDate            String?
  // Schedule badge stored by the schedule-variance job (redesign R2d: computed from sprints).
  scheduleStatus             String?
  scheduleVarianceComputedAt DateTime?
  // Set when the "behind" web notification went out; cleared when the project recovers.
  scheduleBehindAlertedAt    DateTime?
  // UBEC IRL early-warning alerts: { [alertKey]: ISO time the alert was raised } for the alerts that are
  // currently active (stalled, site update overdue, spend ahead of progress); a key is removed when the
  // condition clears, so each alert is sent once per occurrence.
  alertStateJson             Json      @default("{}")

  // Phase 10: construction phase and retention (dates are YYYY-MM-DD in the project zone).
  constructionPhase               ConstructionPhase @default(ACTIVE_CONSTRUCTION)
  constructionPhaseChangedAt      DateTime?
  retentionPercentage             Decimal?          @db.Decimal(5, 2)
  retentionReleaseAtCompletionPct Decimal           @default(0) @db.Decimal(5, 2)
  retentionDurationMonths         Int?
  practicalCompletionDate         String?
  retentionStartDate              String?
  retentionEndDate                String?
  // Sums of the ProjectContractor balances, kept in the same transactions.
  retentionHeldNgn                Decimal           @default(0) @db.Decimal(18, 2)
  retentionReleasedNgn            Decimal           @default(0) @db.Decimal(18, 2)

  monitorOrganizationId String? @db.Uuid
  lenderOrganizationId  String? @db.Uuid

  // Phase 11: delivery model. The snapshot is the type config when applied (later type edits do not
  // change it); a project without a type behaves as before Phase 11.
  owningOrganizationId    String? @db.Uuid
  projectTypeId           String? @db.Uuid
  projectTypeVersion      Int?
  projectTypeSnapshotJson Json?
  regionId                String? @db.Uuid

  // Phase 13: contract details (dates YYYY-MM-DD in the project zone). kickoffDate is the planned
  // kick-off; contract milestones count from these anchors.
  contractReference      String?
  contractAwardDate      String?
  contractSignedDate     String?
  contractSumNgn         Decimal?  @db.Decimal(18, 2)
  kickoffDate            String?
  kickoffHeldAt          DateTime?
  // Redesign R4 (D-R4.39): officers given to generated visits; the first is the lead.
  defaultVisitOfficerIds String[]  @db.Uuid

  // Redesign R2c: needs-assessment details (filled from the workbook's Project sheet; the Needs
  // Assessment module uses them too).
  siteAddress            String? @db.Text
  strategicJustification String? @db.Text
  assumptions            String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  monitorOrganization Organization?        @relation("MonitorOrganization", fields: [monitorOrganizationId], references: [id])
  lenderOrganization  Organization?        @relation("LenderOrganization", fields: [lenderOrganizationId], references: [id])
  owningOrganization  Organization?        @relation("OwningOrganization", fields: [owningOrganizationId], references: [id])
  projectType         ProjectType?         @relation(fields: [projectTypeId], references: [id], onDelete: Restrict)
  region              Region?              @relation(fields: [regionId], references: [id], onDelete: Restrict)
  lot                 ProjectLot?          @relation(fields: [lotId], references: [id], onDelete: Restrict)
  beneficiaries       ProjectBeneficiary[]
  contractors         ProjectContractor[]
  boqRevisions        BoqRevision[]

  userAssignments        UserProjectAssignment[]
  fieldSessions          FieldAgentSession[]
  boqItems               BoqItem[]
  evidenceLogs           FieldEvidenceLog[]
  auditLogs              AuditLog[]
  incidentReports        IncidentReport[]
  notifications          MobileNotification[]
  webNotifications       WebNotification[]
  // Phase 7
  processConfig          ProjectProcessConfig?
  approvalSteps          ApprovalStep[]
  approvalActions        ApprovalAction[]
  standards              ProjectStandardSpecification[]
  needsAssessments       ProjectNeedsAssessmentDocument[]
  // Phase 8
  outboundMessages       OutboundMessage[]
  // Phase 10
  handoverSubmissions    HandoverSubmission[]
  defectTickets          RetentionDefectTicket[]
  // Phase 14 (findings; R4 visits raise them)
  findings               Finding[]
  // Phase 13
  documents              ProjectDocument[]
  contractMilestones     ProjectContractMilestone[]
  kickoffMeeting         KickoffMeeting?
  defaultCases           ContractorDefaultCase[]
  // Phase 15
  completionCertificates CompletionCertificate[]
  payments               ProjectPayment[]
  closureChecklistItems  ClosureChecklistItemState[]
  contractorRatings      ContractorPerformanceRating[]
  lessonsLearned         LessonLearned[]
  kpiSnapshots           KpiSnapshot[] // Phase 16
  closurePackExports     ClosurePackExport[]
  // Redesign R2b
  sprints                ProjectSprint[]
  facilityUnits          FacilityUnit[]
  visitFormSnapshots     VisitFormSnapshot[] // Redesign R3
  visits                 Visit[] // Redesign R4
  visitSubmissions       VisitSubmission[]
  siteLogEntries         SiteLogEntry[]

  @@unique([tenantId, codePrefix])
  @@unique([tenantId, externalReference])
  @@unique([lotId, batchNumber])
  @@index([tenantId, stateCode])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([monitorOrganizationId])
  @@index([lenderOrganizationId])
  @@index([owningOrganizationId])
  @@index([projectTypeId])
  @@index([regionId])
}

// The contractor on a project (Phase 6). Redesign R1d (decision T): one contractor per project, no
// replacement. The contractor has no login (decision P2); it is an organisation record with contacts.
model ProjectContractor {
  id                      String         @id @default(uuid()) @db.Uuid
  projectId               String         @db.Uuid
  organizationId          String         @db.Uuid
  tradeCategory           String
  tradeCode               String
  allocatedBudgetNgn      Decimal?       @db.Decimal(18, 2)
  plannedMobilizationDate DateTime?      @db.Date
  plannedCompletionDate   DateTime?      @db.Date
  // Phase 13: contract state. A terminated contractor keeps its history (progress, retention).
  contractStatus          ContractStatus @default(ACTIVE)
  terminatedAt            DateTime?
  terminationCaseId       String?        @db.Uuid
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  project            Project                       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organization       Organization                  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  defectTickets      RetentionDefectTicket[]
  // Phase 14
  findings           Finding[]
  // Phase 13
  documents          ProjectDocument[]
  contractMilestones ProjectContractMilestone[]
  defaultCases       ContractorDefaultCase[]
  // Phase 15
  performanceRatings ContractorPerformanceRating[]

  @@unique([projectId, organizationId])
  @@unique([projectId, tradeCode])
  @@index([organizationId])
  @@map("project_contractors")
}

// One BOQ upload after activation (Phase 6). Uploads while the project is a draft need no revision.
model BoqRevision {
  id               String   @id @default(uuid()) @db.Uuid
  projectId        String   @db.Uuid
  revisionNumber   Int
  uploadedByUserId String   @db.Uuid
  reason           String
  itemCount        Int
  createdAt        DateTime @default(now())

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  boqItems BoqItem[]

  @@unique([projectId, revisionNumber])
  @@map("boq_revisions")
}

// One unit of field provenance: a provisioned account's session for one project on one device.
// Redesign R1d: join codes, join-code sessions and identity assurance are deleted (decision P2).
model FieldAgentSession {
  id                     String           @id @default(uuid()) @db.Uuid
  projectId              String           @db.Uuid
  userId                 String           @db.Uuid
  mobileDeviceId         String?          @db.Uuid
  roleId                 String           @db.Uuid
  roleNameSnapshot       String
  fieldPersonaType       FieldPersonaType @default(INDEPENDENT_VERIFIER)
  assuranceWeight        Float            @default(1.0)
  agentFullName          String
  agentPhoneNumber       String
  deviceId               String
  deviceModel            String?
  deviceOs               String?
  // Per-install Ed25519 public key (base64 raw). Captures, reports and pings are signed with it.
  devicePublicKey        String?
  devicePublicKeyAlg     String?
  devicePublicKeyId      String?
  devicePublicKeyAddedAt DateTime?
  isActive               Boolean          @default(true)
  revokedAt              DateTime?
  revokedByUserId        String?          @db.Uuid
  revokeReason           String?
  lastSyncAt             DateTime?
  createdAt              DateTime         @default(now())

  project           Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user              User                     @relation(fields: [userId], references: [id], onDelete: Restrict)
  mobileDevice      MobileDevice?            @relation(fields: [mobileDeviceId], references: [id], onDelete: Restrict)
  role              Role                     @relation(fields: [roleId], references: [id], onDelete: Restrict)
  evidenceLogs      FieldEvidenceLog[]
  incidentReports   IncidentReport[]
  pushTokens        PushToken[]
  notifications     MobileNotification[]
  notificationReads MobileNotificationRead[]

  @@unique([userId, projectId, deviceId])
  @@index([projectId, roleId])
  @@index([deviceId])
  @@index([userId])
}

// A device a provisioned user has signed in on. Holds the per-install signing key (Phase 4) that
// is copied onto each of the user's sessions on this device. Revoking it blocks every project.
model MobileDevice {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @db.Uuid
  deviceId        String
  deviceModel     String?
  deviceOs        String?
  publicKey       String
  publicKeyAlg    String
  publicKeyId     String
  lastSeenAt      DateTime?
  revokedAt       DateTime?
  revokedByUserId String?   @db.Uuid
  revokeReason    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  fieldSessions FieldAgentSession[]
  pushTokens    PushToken[]

  @@unique([userId, deviceId])
  @@index([userId])
  @@map("mobile_devices")
}

model BoqItem {
  id             String  @id @default(uuid()) @db.Uuid
  projectId      String  @db.Uuid
  // Last post-activation BOQ revision that changed this item.
  lastRevisionId String? @db.Uuid
  // Redesign R2b: the facility unit this scope line belongs to (null on legacy projects).
  facilityUnitId String? @db.Uuid

  wbsCode         String // e.g., "02.03.1"
  section         String // e.g., "BILL NO. 2 — DRAINAGE & CULVERTS"
  description     String
  unit            String // e.g., "m3", "m", "tons", "bags", "item"
  totalQuantity   Decimal @db.Decimal(14, 3)
  rateNgn         Decimal @db.Decimal(18, 2)
  budgetedCostNgn Decimal @db.Decimal(18, 2)

  isOpaqueLumpSum        Boolean @default(false)
  opacityWarningReason   String?
  // Line progress (legacy name): follows its unit's accepted visits (R4); a line without unit
  // progress keeps the value stored before redesign R5f deleted reports.
  cumulativeCertifiedPct Decimal @default(0) @db.Decimal(5, 2)

  // Phase 9: schedule (YYYY-MM-DD in the project zone). The original window is kept for good once
  // the project is live; revisions only move the planned window.
  plannedStartDate     String?
  plannedEndDate       String?
  actualStartDate      String?
  actualCompletionDate String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  lastRevision BoqRevision?  @relation(fields: [lastRevisionId], references: [id], onDelete: SetNull)
  facilityUnit FacilityUnit? @relation(fields: [facilityUnitId], references: [id], onDelete: SetNull)

  @@unique([projectId, wbsCode])
  @@index([facilityUnitId])
}

// One capture: a photo, voice note or document with its hardware metadata (Phase 4).
// Redesign R5f: captures belong to visit submissions, site log entries, defects and findings.
model FieldEvidenceLog {
  id               String            @id @default(uuid()) @db.Uuid
  projectId        String            @db.Uuid
  fieldSessionId   String            @db.Uuid
  clientCaptureId  String            @unique @db.Uuid
  reporterRoleId   String?           @db.Uuid
  reporterRoleName String            @default("Field Reporter")
  fieldPersonaType FieldPersonaType  @default(INDEPENDENT_VERIFIER)
  assuranceWeight  Float             @default(1.0)
  status           EvidenceLogStatus @default(REGISTERED)
  caption          String?

  // GPS at capture. Location fields are null when the device had no fix.
  locationAvailable      Boolean
  latitude               Float?
  longitude              Float?
  altitudeMeters         Float?
  gpsAccuracyMeters      Float?
  // UBEC IRL: compass heading of the camera when the photo was taken (0–360, true or magnetic as the
  // device reports it; null when the phone has no compass or no reading).
  headingDegrees         Float?
  isMockLocation         Boolean         @default(false)
  // Server-evaluated. null = no fix or evaluation failed; never the client's claim.
  // isWithinGeofence = INSIDE or WITHIN_TOLERANCE (Phase 6), kept for older readers.
  isWithinGeofence       Boolean?
  geofenceStatus         GeofenceStatus?
  // Distance outside the boundary in metres (0 when inside); null when not evaluated.
  distanceOutsideMeters  Float?
  distanceFromSiteMeters Float?

  // Device orientation and provenance
  devicePitchDeg                 Float?
  deviceRollDeg                  Float?
  deviceAzimuthDeg               Float?
  deviceSignature                String?
  devicePublicKeyId              String?
  // true = valid, false = invalid, null = unsigned or no key registered
  signatureVerified              Boolean?
  clientSha256                   String?
  serverSha256                   String?
  integrityPassed                Boolean  @default(true)
  integrityFlags                 Json     @default("[]")
  // Phase 5 Step 8: re-submitted under a new session after the session that captured it ended.
  // The original keeps its own session; this row is never merged into it.
  resubmittedFromClientCaptureId String?  @db.Uuid
  resubmittedFromEvidenceLogId   String?  @db.Uuid
  // Redesign R4c: a photo or voice note answering one visit form question (answer path), and its unit.
  visitSubmissionId              String?  @db.Uuid
  visitAnswerPath                String?
  facilityUnitId                 String?  @db.Uuid

  // Voice notes: NOT_APPLICABLE | PENDING | DONE | FAILED
  transcriptionStatus String  @default("NOT_APPLICABLE")
  transcript          String?
  transcriptionEngine String?

  capturedAtDevice DateTime
  syncedAtServer   DateTime @default(now())

  project          Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fieldSession     FieldAgentSession @relation(fields: [fieldSessionId], references: [id], onDelete: Restrict)
  visitSubmission  VisitSubmission?  @relation(fields: [visitSubmissionId], references: [id], onDelete: SetNull)
  siteLogEntry     SiteLogEntry?
  mediaAttachments EvidenceMedia[]

  @@index([projectId, status])
  @@index([visitSubmissionId])
  @@index([fieldSessionId, capturedAtDevice])
}

model EvidenceMedia {
  id              String    @id @default(uuid()) @db.Uuid
  evidenceLogId   String    @db.Uuid
  // Denormalised so duplicate screening is an indexed lookup within one tenant.
  tenantId        String    @db.Uuid
  projectId       String    @db.Uuid
  mediaType       MediaType
  objectKey       String
  mimeType        String
  byteSize        Int
  // Computed by the server from the stored bytes.
  sha256FileHash  String
  // 64-bit difference hash (16 hex chars), computed by the server from image bytes.
  perceptualHash  String?
  durationSeconds Float?
  createdAt       DateTime  @default(now())

  evidenceLog FieldEvidenceLog @relation(fields: [evidenceLogId], references: [id], onDelete: Cascade)

  @@index([evidenceLogId])
  @@index([tenantId, sha256FileHash])
  @@index([tenantId, mediaType])
}

model AuditLog {
  id               String          @id @default(uuid()) @db.Uuid
  tenantId         String          @db.Uuid
  projectId        String?         @db.Uuid
  seq              BigInt
  actorType        AuditActorType
  actorId          String
  actorDisplayName String
  action           AuditActionType
  summaryText      String
  payload          Json
  previousHash     String
  entryHash        String          @unique
  createdAt        DateTime        @default(now())

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([tenantId, projectId, seq])
  @@index([projectId, seq])
  @@index([tenantId, seq])
}

model PushToken {
  id             String   @id @default(uuid()) @db.Uuid
  deviceToken    String
  // One phone can hold a provisioned account and several join-code sessions (Phase 5), so a token
  // is unique per owner: "session:<id>", "user:<id>" (mobile account) or "web:<id>".
  ownerKey       String
  devicePlatform String // ANDROID, IOS, WEB
  appVersion     String?
  sessionId      String?  @db.Uuid
  userId         String?  @db.Uuid
  // Set when a provisioned account registers from the mobile app; revoking the device removes it.
  mobileDeviceId String?  @db.Uuid
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  session      FieldAgentSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user         User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  mobileDevice MobileDevice?      @relation(fields: [mobileDeviceId], references: [id], onDelete: Cascade)

  @@unique([deviceToken, ownerKey])
  @@index([sessionId])
  @@index([userId])
  @@map("push_tokens")
}

model IncidentReport {
  id                          String    @id @default(uuid()) @db.Uuid
  clientIncidentId            String    @unique @db.Uuid
  projectId                   String    @db.Uuid
  reporterSessionId           String    @db.Uuid
  category                    String // WHISTLEBLOWING, SITE_EMERGENCY, CRITICAL_DELAY, MATERIAL_FAILURE
  severity                    String    @default("HIGH") // CRITICAL, HIGH, MEDIUM, LOW
  title                       String
  description                 String    @db.Text
  isConfidentialWhistleblower Boolean   @default(false)
  status                      String    @default("OPEN") // OPEN, UNDER_REVIEW, ACTION_TAKEN, DISMISSED
  photoEvidenceUrls           String[]
  voiceNoteUrl                String?
  deviceGpsCoordinates        Json?
  createdAt                   DateTime  @default(now())
  resolvedAt                  DateTime?

  project         Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reporterSession FieldAgentSession @relation(fields: [reporterSessionId], references: [id], onDelete: Cascade)

  @@index([projectId, category])
  @@index([projectId, status])
  @@map("incident_reports")
}

model MobileNotification {
  id                  String                 @id @default(uuid()) @db.Uuid
  projectId           String                 @db.Uuid
  fieldSessionId      String?                @db.Uuid
  type                MobileNotificationType
  actionType          NotificationActionType @default(NONE)
  requiresAction      Boolean                @default(false)
  title               String
  message             String                 @db.Text
  metadata            Json                   @default("{}")
  createdAt           DateTime               @default(now())
  // Phase 5 Step 8: set when anyone completes the action this notification asks for; it then shows
  // as done for every session. See notifications/notificationActions.ts for what completes what.
  actionedAt          DateTime?
  actionedBySessionId String?                @db.Uuid
  actionedByUserId    String?                @db.Uuid
  actionedByName      String?

  project      Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fieldSession FieldAgentSession?       @relation(fields: [fieldSessionId], references: [id], onDelete: Cascade)
  reads        MobileNotificationRead[]

  @@index([projectId, createdAt])
  @@index([fieldSessionId, createdAt])
  @@map("mobile_notifications")
}

// Read state per field session (Phase 2 carry-over). A broadcast notification (fieldSessionId null)
// read by one field user stays unread for everyone else.
model MobileNotificationRead {
  notificationId String   @db.Uuid
  fieldSessionId String   @db.Uuid
  readAt         DateTime @default(now())

  notification MobileNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  fieldSession FieldAgentSession  @relation(fields: [fieldSessionId], references: [id], onDelete: Cascade)

  @@id([notificationId, fieldSessionId])
  @@index([fieldSessionId])
  @@map("mobile_notification_reads")
}

model WebNotification {
  id                         String   @id @default(uuid()) @db.Uuid
  projectId                  String   @db.Uuid
  targetPermissionKey        String   @default("visits:view")
  targetRoleId               String?  @db.Uuid
  category                   String // REPORT_RESUBMITTED | CONFLICT_FLAG | CONTRACTOR_ONBOARDING | TRANCHE_DISBURSEMENT | MONITOR_QUERY | AI_OMISSION_FLAG
  title                      String
  description                String   @db.Text
  actionUrl                  String?
  metadata                   Json     @default("{}")
  // Phase 10: only users of this organisation see it (e.g. the contractor a defect is assigned to).
  targetOrganizationId       String?  @db.Uuid
  // Phase 10: hidden from users whose organisation is a contractor on the project (monitoring side only).
  hideFromProjectContractors Boolean  @default(false)
  createdAt                  DateTime @default(now())

  project Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reads   WebNotificationRead[]

  @@index([projectId, targetPermissionKey, createdAt])
  @@map("web_notifications")
}

model WebNotificationRead {
  notificationId String   @db.Uuid
  userId         String   @db.Uuid
  readAt         DateTime @default(now())

  notification WebNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([notificationId, userId])
  @@index([userId])
  @@map("web_notification_reads")
}

// ============================================================================
// PHASE 7: PROCESS ENGINE, STANDARDS, APPROVAL CHAINS
// ============================================================================

// A tenant's reusable process. Applying it copies configJson into the project's own rows, so
// later template edits never change a project (WorkflowTemplateConfigSchema validates it).
model WorkflowTemplate {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  name        String
  description String?
  isDefault   Boolean  @default(false)
  configJson  Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projectTypes ProjectType[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("workflow_templates")
}

model ProjectProcessConfig {
  id                         String                  @id @default(uuid()) @db.Uuid
  projectId                  String                  @unique @db.Uuid
  // Provenance only: the template the settings were copied from.
  workflowTemplateId         String?                 @db.Uuid
  needsAssessmentMode        DocumentRequirementMode @default(OPTIONAL_AT_CREATION)
  standardsSpecificationMode DocumentRequirementMode @default(OPTIONAL_AT_CREATION)
  requireReportApproval      Boolean                 @default(false)
  enableHandoverModule       Boolean                 @default(false)
  enableRetentionModule      Boolean                 @default(false)
  createdAt                  DateTime                @default(now())
  updatedAt                  DateTime                @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_process_configs")
}

// One step of a project's approval chain. Chains are never edited in place: a change writes a new
// version (and deactivates the old one), and items in flight keep the version they started on.
model ApprovalStep {
  id                    String                    @id @default(uuid()) @db.Uuid
  projectId             String                    @db.Uuid
  chainType             ApprovalChainType
  version               Int
  stepOrder             Int
  label                 String
  requiredPermissionKey String
  requiredRoleId        String?                   @db.Uuid
  minAmountThresholdNgn Decimal?                  @db.Decimal(18, 2)
  isSystemStep          Boolean                   @default(false)
  // Phase 11
  organizationScope     ApprovalOrganizationScope @default(ANY)
  isActive              Boolean                   @default(true)
  createdAt             DateTime                  @default(now())

  project Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actions ApprovalAction[]

  @@unique([projectId, chainType, version, stepOrder])
  @@index([projectId, chainType, isActive])
  @@map("approval_steps")
}

model ApprovalAction {
  id          String              @id @default(uuid()) @db.Uuid
  projectId   String              @db.Uuid
  chainType   ApprovalChainType
  subjectType ApprovalSubjectType
  subjectId   String              @db.Uuid
  stepId      String              @db.Uuid
  stepOrder   Int
  decision    ApprovalDecision
  actorUserId String              @db.Uuid
  notes       String?
  createdAt   DateTime            @default(now())

  project Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  step    ApprovalStep @relation(fields: [stepId], references: [id], onDelete: Restrict)
  actor   User         @relation(fields: [actorUserId], references: [id])

  @@index([subjectType, subjectId, createdAt])
  @@index([projectId, chainType])
  @@map("approval_actions")
}

model ProjectStandardSpecification {
  id                 String           @id @default(uuid()) @db.Uuid
  projectId          String           @db.Uuid
  code               String
  title              String
  category           StandardCategory
  specificationText  String           @db.Text
  documentObjectKey  String?
  // Empty = the whole project; otherwise WBS codes, each covering the codes below it.
  applicableWbsCodes Json             @default("[]")
  isMandatory        Boolean          @default(true)
  createdByUserId    String           @db.Uuid
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, code])
  @@map("project_standard_specifications")
}

model ProjectNeedsAssessmentDocument {
  id               String                 @id @default(uuid()) @db.Uuid
  projectId        String                 @db.Uuid
  title            String
  documentType     NeedsAssessmentDocType
  objectKey        String
  mimeType         String
  byteSize         Int
  uploadedByUserId String                 @db.Uuid
  uploadedAt       DateTime               @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_needs_assessment_documents")
}

// ============================================================================
// PHASE 8: CADENCE, JOBS, OUTBOUND MESSAGES
// ============================================================================

// One claimed unit of scheduled work. The unique (jobName, scopeKey) makes each unit run once
// across API instances; a FAILED unit may be claimed again.
model JobRun {
  id         String       @id @default(uuid()) @db.Uuid
  jobName    String
  scopeKey   String
  startedAt  DateTime     @default(now())
  finishedAt DateTime?
  status     JobRunStatus @default(RUNNING)
  detail     String?

  @@unique([jobName, scopeKey])
  @@index([jobName, startedAt])
  @@map("job_runs")
}

model OutboundMessage {
  id                String                @id @default(uuid()) @db.Uuid
  tenantId          String                @db.Uuid
  projectId         String?               @db.Uuid
  channel           OutboundChannel
  toAddress         String
  templateKey       String
  payloadJson       Json                  @default("{}")
  status            OutboundMessageStatus @default(QUEUED)
  providerMessageId String?
  error             String?
  attempts          Int                   @default(0)
  nextAttemptAt     DateTime              @default(now())
  createdAt         DateTime              @default(now())
  sentAt            DateTime?

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([tenantId, createdAt])
  @@index([toAddress, createdAt])
  @@map("outbound_messages")
}

// ---------------------------------------------------------------------------
// Phase 9: schedule dependencies and revisions
// ---------------------------------------------------------------------------

// ============================================================================
// Phase 10: stakeholder handover, retention and defects
// ============================================================================

// The beneficiary's handover response, recorded by staff from the signed paper copy (redesign R1d:
// the public handover link is deleted, decision P2). Reviewing an accepted response issues the
// handover certificate (Phase 15).
model HandoverSubmission {
  id               String                  @id @default(uuid()) @db.Uuid
  projectId        String                  @db.Uuid
  stakeholderType  HandoverStakeholderType
  decision         HandoverDecision
  submitterName    String
  submitterRole    String
  // Plain text (sanitised); never HTML.
  feedbackText     String                  @db.Text
  // [{ title, location, description }]
  snagsJson        Json                    @default("[]")
  // The officer who recorded the response and attested it matches the signed copy.
  recordedByUserId String                  @db.Uuid
  submittedAt      DateTime                @default(now())
  reviewedByUserId String?                 @db.Uuid
  reviewedAt       DateTime?
  reviewNotes      String?

  project       Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  defectTickets RetentionDefectTicket[]

  @@index([projectId, submittedAt])
  @@map("handover_submissions")
}

model RetentionDefectTicket {
  id                         String             @id @default(uuid()) @db.Uuid
  projectId                  String             @db.Uuid
  // Per-project running number (DEF-001).
  ticketNumber               Int
  // The liable party: the project's contractor (one per project, decision T). Defects are staff-only (R1d).
  projectContractorId        String             @db.Uuid
  boqItemId                  String?            @db.Uuid
  sourceHandoverSubmissionId String?            @db.Uuid
  sourceSnagIndex            Int?
  title                      String
  description                String             @db.Text
  location                   String?
  severity                   DefectSeverity     @default(MEDIUM)
  status                     DefectTicketStatus @default(OPEN)
  dueDate                    String?
  raisedByUserId             String             @db.Uuid
  assignedAt                 DateTime?
  // clientCaptureIds of Phase 4 captures.
  rectificationCaptureIds    Json               @default("[]")
  rectificationNotes         String?
  rectifiedAt                DateTime?
  rectifiedByLabel           String?
  verificationCaptureIds     Json               @default("[]")
  verificationNotes          String?
  verifiedByUserId           String?            @db.Uuid
  verifiedByLabel            String?
  verifiedAt                 DateTime?
  // Reason for "not a defect" or the last reopen.
  resolutionReason           String?
  reopenCount                Int                @default(0)
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt

  project           Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectContractor ProjectContractor   @relation(fields: [projectContractorId], references: [id], onDelete: Restrict)
  sourceSubmission  HandoverSubmission? @relation(fields: [sourceHandoverSubmissionId], references: [id], onDelete: SetNull)

  @@unique([projectId, ticketNumber])
  @@unique([sourceHandoverSubmissionId, sourceSnagIndex])
  @@index([projectId, status])
  @@index([projectContractorId, status])
  @@map("retention_defect_tickets")
}

// ---------------------------------------------------------------------------
// Phase 11: delivery models
// ---------------------------------------------------------------------------

// A delivery model. References a workflow template (process and chains) and holds the rest in
// configJson (ProjectTypeConfigSchema). Every save bumps version; projects keep their snapshot.
model ProjectType {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @db.Uuid
  code               String
  name               String
  description        String?
  colour             String?
  workflowTemplateId String   @db.Uuid
  configJson         Json
  version            Int      @default(1)
  isActive           Boolean  @default(true)
  isDefault          Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workflowTemplate WorkflowTemplate @relation(fields: [workflowTemplateId], references: [id], onDelete: Restrict)
  projects         Project[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("project_types")
}

// Tenant regions, two levels (region -> area).
model Region {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  name           String
  code           String
  parentRegionId String?  @db.Uuid
  isArchived     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parentRegion Region?   @relation("RegionHierarchy", fields: [parentRegionId], references: [id], onDelete: Restrict)
  areas        Region[]  @relation("RegionHierarchy")
  projects     Project[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([parentRegionId])
  @@map("regions")
}

model ProjectBeneficiary {
  id              String          @id @default(uuid()) @db.Uuid
  projectId       String          @db.Uuid
  name            String
  beneficiaryType BeneficiaryType
  contactName     String?
  contactEmail    String?
  contactPhone    String?
  address         String?
  isPrimary       Boolean         @default(false)
  createdAt       DateTime        @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_beneficiaries")
}

// ---------------------------------------------------------------------------
// Phase 14: findings (R5f deleted streams and site inspections; R4 visits raise findings)
// ---------------------------------------------------------------------------

enum FindingSeverity {
  MINOR
  MAJOR
  CRITICAL
}

enum FindingStatus {
  OPEN
  RESOLVED
  DISMISSED
}

// A failed visit answer raised against the contractor (monitoring side when null). Redesign R7
// renamed the model (was InspectionFinding, table inspection_findings) and dropped the Phase 14
// inspectionId: every finding comes from a visit submission. checklistItemKey holds the field key.
model Finding {
  id                        String          @id @default(uuid()) @db.Uuid
  projectId                 String          @db.Uuid
  checklistItemKey          String
  visitId                   String?         @db.Uuid
  visitSubmissionId         String          @db.Uuid
  facilityId                String?         @db.Uuid
  facilityUnitId            String?         @db.Uuid
  // The answer path (s:/f:...) and the question as shown.
  questionKey               String?
  title                     String?
  recheckCount              Int             @default(0)
  lastRecheckedSubmissionId String?         @db.Uuid
  lastRecheckedAt           DateTime?
  escalatedAt               DateTime?
  projectContractorId       String?         @db.Uuid
  description               String          @db.Text
  severity                  FindingSeverity @default(MAJOR)
  status                    FindingStatus   @default(OPEN)
  resolvedNotes             String?         @db.Text
  // FieldEvidenceLog ids of the resolution photos.
  resolutionCaptureIds      String[]        @db.Uuid
  raisedByUserId            String?         @db.Uuid
  raisedByName              String?
  resolvedByUserId          String?         @db.Uuid
  resolvedByName            String?
  createdAt                 DateTime        @default(now())
  resolvedAt                DateTime?

  project           Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectContractor ProjectContractor? @relation(fields: [projectContractorId], references: [id], onDelete: SetNull)

  @@index([projectId, status])
  @@index([visitId])
  @@index([projectContractorId, status])
  @@map("findings")
}

// ---------------------------------------------------------------------------
// Phase 13: document register, contract milestones, kick-off, default cases, programme of works
// ---------------------------------------------------------------------------

enum ContractStatus {
  ACTIVE
  TERMINATED
}

enum ContractMilestoneAnchor {
  CONTRACT_AWARD
  CONTRACT_SIGNED
  KICKOFF
  ACTIVATION
  MILESTONE
  // Phase 15
  COC_ISSUED
  PROJECT_CLOSED
}

enum MilestoneOffsetUnit {
  CALENDAR_DAYS
  WORKING_DAYS
}

enum ContractMilestoneStatus {
  PENDING
  DUE
  OVERDUE
  DONE
  WAIVED
}

enum MilestoneCompletionMode {
  MANUAL
  AUTO_CONTRACTOR_ON_SITE
  AUTO_KICKOFF_NOTICE_SENT
  AUTO_KICKOFF_QUORUM
  AUTO_SCHEDULE_BASELINE_SET
  // Phase 15
  AUTO_COC_ISSUED
  AUTO_HANDOVER_ACCEPTED
  AUTO_FINAL_EVALUATION_APPROVED
}

enum DefaultCaseTrigger {
  MILESTONE_OVERDUE
  MANUAL
}

enum DefaultCaseStatus {
  OPEN
  IN_REVIEW
  CURE_PERIOD
  EXTENSION_GRANTED
  TERMINATED
  CLOSED
