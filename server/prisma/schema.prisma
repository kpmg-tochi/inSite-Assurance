}

/// An authenticated acknowledgement of one document version (not a qualified e-signature).
model ProjectDocumentSignOff {
  id             String   @id @default(uuid()) @db.Uuid
  documentId     String   @db.Uuid
  version        Int
  userId         String   @db.Uuid
  roleId         String?  @db.Uuid
  organizationId String?  @db.Uuid
  statement      String
  statementHash  String
  signedAt       DateTime @default(now())

  document ProjectDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, version, userId])
  @@map("project_document_sign_offs")
}

/// Dated obligations from the project type's templates. One row per contractor for per-contractor
/// templates; (projectId, key, COALESCE(projectContractorId)) is unique (hand-written index).
model ProjectContractMilestone {
  id                           String                   @id @default(uuid()) @db.Uuid
  projectId                    String                   @db.Uuid
  projectContractorId          String?                  @db.Uuid
  key                          String
  label                        String
  description                  String?
  anchor                       ContractMilestoneAnchor
  anchorMilestoneKey           String?
  offsetValue                  Int
  offsetUnit                   MilestoneOffsetUnit      @default(CALENDAR_DAYS)
  // Replacement contractors count from this date instead of the anchor.
  anchorDateOverride           String?
  dueDate                      String?
  status                       ContractMilestoneStatus  @default(PENDING)
  completionMode               MilestoneCompletionMode  @default(MANUAL)
  requiredDocumentTypeCodes    String[]                 @default([])
  requiresSignOffPermissionKey String?
  responsibleRoleId            String?                  @db.Uuid
  responsibleOrganizationScope String                   @default("ANY")
  completedAt                  DateTime?
  completedByUserId            String?                  @db.Uuid
  completedNotes               String?
  waivedReason                 String?
  // Notifications (milestone-deadlines job): last status notified and reminder offsets sent for
  // the current due date; both reset when the due date moves.
  lastNotifiedAt               DateTime?
  lastNotifiedStatus           ContractMilestoneStatus?
  remindedOffsetsDays          Int[]                    @default([])
  sortOrder                    Int                      @default(0)
  createdAt                    DateTime                 @default(now())
  updatedAt                    DateTime                 @updatedAt

  project           Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectContractor ProjectContractor?      @relation(fields: [projectContractorId], references: [id], onDelete: Cascade)
  documents         ProjectDocument[]
  defaultCases      ContractorDefaultCase[]

  @@index([projectId, status])
  @@index([projectContractorId])
  @@map("project_contract_milestones")
}

model KickoffMeeting {
  id                 String    @id @default(uuid()) @db.Uuid
  projectId          String    @unique @db.Uuid
  scheduledAt        DateTime
  location           String?
  virtualLink        String?
  agendaDocumentId   String?   @db.Uuid
  minutesDocumentId  String?   @db.Uuid
  noticeSentAt       DateTime?
  noticeWaivedReason String?
  heldAt             DateTime?
  quorumMet          Boolean?
  quorumWaivedReason String?
