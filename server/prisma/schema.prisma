  updatedAt          DateTime  @updatedAt

  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  agendaDocument  ProjectDocument? @relation("KickoffAgenda", fields: [agendaDocumentId], references: [id], onDelete: SetNull)
  minutesDocument ProjectDocument? @relation("KickoffMinutes", fields: [minutesDocumentId], references: [id], onDelete: SetNull)
  invitees        KickoffInvitee[]

  @@map("kickoff_meetings")
}

model KickoffInvitee {
  id                String   @id @default(uuid()) @db.Uuid
  meetingId         String   @db.Uuid
  stakeholderGroup  String
  name              String
