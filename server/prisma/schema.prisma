generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// ENUMS
// ============================================================================

enum TenantStatus {
  ACTIVE
  SUSPENDED
  TRIAL
}

enum RoleSurface {
  WEB
  MOBILE
  BOTH
}

enum FieldPersonaType {
  INDEPENDENT_VERIFIER
  CONTRACTOR_EXECUTOR
  NONE
}

enum OrganizationCategory {
  ADVISORY_MONITOR
  FINANCIER_LENDER
  CONTRACTOR
  CLIENT_OWNER
  GOVERNMENT_MDA
  OTHER
}

enum PermissionCategory {
  TENANT_ADMIN
  PORTFOLIO_PROJECTS
  BOQ_SCHEDULE
  MOBILIZATION_ASSURANCE
  FIELD_PRESENCE
  REPORT_APPROVALS
  FINANCIAL_IPC
  AUDIT_CLOSEOUT
}

enum ProfessionalLicenseType {
  QSRBN // Quantity Surveyors Registration Board of Nigeria
  COREN // Council for the Regulation of Engineering in Nigeria
  ARCON // Architects Registration Council of Nigeria
  CORBON // Council of Registered Builders of Nigeria
  ICAN // Institute of Chartered Accountants of Nigeria
  OTHER
}

// FieldPersonaType replaces static IndependenceTier enum on Role & FieldAgentSession

enum GeofenceMode {
  RADIAL
  LINEAR_CORRIDOR
}

enum ReportingCadence {
  DAILY
  WEEKLY
  BI_WEEKLY
  INSPECTION_ONLY
}

enum PortfolioHealth {
  EVIDENCE_SUPPORTED
  EVIDENCE_PARTIAL
  EVIDENCE_CONFLICT
}

enum EvidenceStrengthRating {
  SUPPORTED
  PARTIALLY_SUPPORTED
  UNSUPPORTED
  CONTRADICTED
}

enum EvidenceLogStatus {
  LOCAL_CAPTURED
  QUEUED_OFFLINE
  UPLOADING_SYNC
  AWAITING_CONFIRMATION
  CONFIRMED
  FLAGGED_INTEGRITY
}

enum MediaType {
  SITE_PHOTO
  VOICE_NOTE
  WAYBILL_DOCUMENT
  LAB_CUBE_TEST_CERT
  MILL_CERTIFICATE
  BOQ_SPREADSHEET
  VALUATION_REPORT_PDF
}

enum ConditionPrecedentStatus {
  PENDING
  SATISFIED
  WAIVED
  BREACHED
}

enum IpcClaimStatus {
  SUBMITTED
  AI_RECONCILED
  QUERIED_BY_MONITOR
  MONITOR_CERTIFIED
  LENDER_DECIDED
  REJECTED_WITHDRAWN
}

enum MonitorRecommendation {
  SUPPORT_FULL_RELEASE
  SUPPORT_WITH_HOLDBACK
  HOLD
}

enum LenderDecisionType {
  APPROVE_FULL
  APPROVE_WITH_HOLDBACK
  HOLD
}

enum QueryStatus {
  OPEN
  RESPONDED
  RESOLVED
}

enum AuditActorType {
  WEB_USER
  FIELD_AGENT
  AI_SYSTEM
}

enum ContractorAssuranceStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum AuditActionType {
  TENANT_CREATED
  TENANT_BRANDING_UPDATED
  ROLE_CREATED
  ROLE_UPDATED
  ROLE_DELETED
  USER_PROJECT_ASSIGNED
  PROJECT_CREATED
  BASELINE_UPDATED
  BOQ_UPLOADED
  JOIN_CODE_ISSUED
  FIELD_AGENT_JOINED
  FIELD_SESSION_STATUS_UPDATED
  CONTRACTOR_ASSURANCE_SUBMITTED
  CONTRACTOR_ASSURANCE_APPROVED
  CONTRACTOR_ASSURANCE_REJECTED
  EVIDENCE_EXTRACTED
  EVIDENCE_CONFIRMED
  EVIDENCE_FLAGGED_INTEGRITY
  IPC_SUBMITTED
  AI_RECONCILIATION_COMPLETED
  MONITOR_QUERY_RAISED
  CONTRACTOR_QUERY_RESPONDED
  VALUATION_REPORT_CERTIFIED
  LENDER_TRANCHE_DECIDED
  INCIDENT_REPORT_SUBMITTED
  INCIDENT_STATUS_UPDATED
  PUSH_TOKEN_REGISTERED
  WORKDAY_REPORT_SUBMITTED
  USER_CREATED
  USER_UPDATED
  USER_DEACTIVATED
  JOIN_CODE_ROTATED
  LOGIN_FAILED_LOCKOUT
  CP_STATUS_CHANGED
  CP_WAIVED
  MONITOR_QUERY_RESOLVED
  IPC_WITHDRAWN
  TRANCHE_DECISION_REVERSED
  TENANT_SETTINGS_UPDATED
}

enum MobileNotificationType {
  ASSURANCE_PENDING
  ASSURANCE_APPROVED
  ASSURANCE_REJECTED
  BACKLOG_REVIEW_REQUIRED
  REPORT_QUERY
  HOLD_POINT_ALERT
  MORNING_DELIVERABLE_READY
  SITE_GEOFENCE_WARNING
}

enum NotificationActionType {
  NONE
  OPEN_REPORT_SUMMARY
  OPEN_WBS_CHAT
  OPEN_BACKLOG_REVIEW
  OPEN_ASSURANCE_WIZARD
}

// ============================================================================
// MODELS
// ============================================================================

// ============================================================================
// MULTI-TENANCY & RELATIONAL RBAC MODELS
// ============================================================================

model Tenant {
  id                   String       @id @default(uuid()) @db.Uuid
  name                 String
  slug                 String       @unique
  status               TenantStatus @default(ACTIVE)
  defaultCurrency      String       @default("NGN")
  timezone             String       @default("Africa/Lagos")
  brandingConfig       Json         @default("{}")
  // Display label and description per canonical EvidenceStrengthRating (decision B).
  evidenceRatingLabels Json         @default("{}")
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  organizations Organization[]
  roles         Role[]
  users         User[]
  projects      Project[]
  auditLogs     AuditLog[]

  @@map("tenants")
}

model Permission {
  id          String             @id @default(uuid()) @db.Uuid
  key         String             @unique
  name        String
  description String
  category    PermissionCategory
  surface     RoleSurface        @default(WEB)
  createdAt   DateTime           @default(now())

  rolePermissions RolePermission[]

  @@index([category])
  @@map("permissions")
}

model Role {
  id                        String           @id @default(uuid()) @db.Uuid
  tenantId                  String           @db.Uuid
  name                      String
  code                      String
  codeSuffix                String?
  description               String?
  surface                   RoleSurface      @default(WEB)
  fieldPersonaType          FieldPersonaType @default(NONE)
  assuranceWeight           Float            @default(1.0)
  requiresIdentityAssurance Boolean          @default(false)
  isSystemDefault           Boolean          @default(false)
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt

  tenant             Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rolePermissions    RolePermission[]
  users              User[]
  projectAssignments UserProjectAssignment[]
  joinCodes          ProjectJoinCode[]
  fieldSessions      FieldAgentSession[]

  @@unique([tenantId, code])
  @@unique([tenantId, codeSuffix])
  @@index([tenantId, surface])
  @@map("roles")
}

model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  roleId       String   @db.Uuid
  permissionId String   @db.Uuid
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Organization {
  id        String               @id @default(uuid()) @db.Uuid
  tenantId  String               @db.Uuid
  name      String
  category  OrganizationCategory @default(OTHER)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users              User[]
  monitoredProjects  Project[] @relation("MonitorOrganization")
  lenderProjects     Project[] @relation("LenderOrganization")
  contractedProjects Project[] @relation("ContractorOrganization")

  @@index([tenantId])
  @@index([category])
}

model User {
  id                        String                   @id @default(uuid()) @db.Uuid
  tenantId                  String                   @db.Uuid
  email                     String                   @unique
  passwordHash              String
  fullName                  String
  isPlatformSuperAdmin      Boolean                  @default(false)
  roleId                    String                   @db.Uuid
  organizationId            String                   @db.Uuid
  professionalLicenseType   ProfessionalLicenseType?
  professionalLicenseNumber String?
  isActive                  Boolean                  @default(true)
  mustChangePassword        Boolean                  @default(false)
  tokenVersion              Int                      @default(0)
  failedLoginCount          Int                      @default(0)
  lockedUntil               DateTime?
  lastLoginAt               DateTime?
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt

  tenant                  Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  notificationReads       WebNotificationRead[]
  role                    Role                    @relation(fields: [roleId], references: [id], onDelete: Restrict)
  organization            Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  projectAssignments      UserProjectAssignment[]
  certifiedReports        ValuationReport[]       @relation("CertifiedByMonitor")
  trancheDecisions        TrancheDecision[]       @relation("DecidedByLender")
  submittedIpcClaims      IpcClaim[]              @relation("SubmittedIpcClaims")
  waivedConditions        ConditionPrecedent[]    @relation("WaivedConditions")
  raisedMonitorQueries    MonitorQuery[]          @relation("RaisedMonitorQueries")
  respondedMonitorQueries MonitorQuery[]          @relation("RespondedMonitorQueries")
  resolvedMonitorQueries  MonitorQuery[]          @relation("ResolvedMonitorQueries")
  pushTokens              PushToken[]
  raisedReportQueries     ReportQuery[]           @relation("RaisedReportQueries")

  @@index([tenantId])
  @@index([organizationId])
  @@index([roleId])
}

model UserProjectAssignment {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  projectId String   @db.Uuid
  roleId    String?  @db.Uuid
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  role    Role?   @relation(fields: [roleId], references: [id], onDelete: SetNull)

  @@unique([userId, projectId])
  @@index([userId])
  @@index([projectId])
  @@map("user_project_assignments")
}

model Project {
  id                   String           @id @default(uuid()) @db.Uuid
  tenantId             String           @db.Uuid
  name                 String
  codePrefix           String // e.g., "LKK-402", unique per tenant
  stateLocation        String // e.g., "Lagos State"
  lgaLocation          String?
  description          String?
  totalBudgetNgn       Decimal          @db.Decimal(18, 2)
  disbursedToDateNgn   Decimal          @default(0) @db.Decimal(18, 2)
  certifiedProgressPct Decimal          @default(0) @db.Decimal(5, 2)
  reportingCadence     ReportingCadence @default(WEEKLY)
  workdayStartTime     String           @default("08:00")
  workdayEndTime       String           @default("17:00")
  geofenceMode         GeofenceMode
  geofenceGeoJson      Json // Typed RadialGeofence or LinearCorridorGeofence
  portfolioHealth      PortfolioHealth  @default(EVIDENCE_PARTIAL)

  monitorOrganizationId    String @db.Uuid
  lenderOrganizationId     String @db.Uuid
  contractorOrganizationId String @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant                 Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  monitorOrganization    Organization @relation("MonitorOrganization", fields: [monitorOrganizationId], references: [id])
  lenderOrganization     Organization @relation("LenderOrganization", fields: [lenderOrganizationId], references: [id])
  contractorOrganization Organization @relation("ContractorOrganization", fields: [contractorOrganizationId], references: [id])

  userAssignments  UserProjectAssignment[]
  joinCodes        ProjectJoinCode[]
  fieldSessions    FieldAgentSession[]
  tranches         FacilityTranche[]
  boqItems         BoqItem[]
  evidenceLogs     FieldEvidenceLog[]
  ipcClaims        IpcClaim[]
  auditLogs        AuditLog[]
  incidentReports  IncidentReport[]
  workdayReports   WorkdayReport[]
  telemetryPings   SiteTelemetryPing[]
  morningBriefs    MorningDeliverableBrief[]
  notifications    MobileNotification[]
  reportQueries    ReportQuery[]
  wbsChatMessages  WbsChatMessage[]
  webNotifications WebNotification[]

  @@unique([tenantId, codePrefix])
  @@index([tenantId])
  @@index([portfolioHealth])
  @@index([monitorOrganizationId])
  @@index([lenderOrganizationId])
  @@index([contractorOrganizationId])
}

model ProjectJoinCode {
  id            String    @id @default(uuid()) @db.Uuid
  projectId     String    @db.Uuid
  roleId        String    @db.Uuid
  code          String    @unique // e.g., "LKK-402-INS-7K2QXM"
  isActive      Boolean   @default(true)
  expiresAt     DateTime?
  maxUses       Int?
  useCount      Int       @default(0)
  rotatedFromId String?   @db.Uuid
  createdAt     DateTime  @default(now())

  project       Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  role          Role                @relation(fields: [roleId], references: [id], onDelete: Restrict)
  fieldSessions FieldAgentSession[]

  @@index([projectId])
  @@index([roleId])
}

model FieldAgentSession {
  id               String           @id @default(uuid()) @db.Uuid
  projectId        String           @db.Uuid
  joinCodeId       String           @db.Uuid
  roleId           String           @db.Uuid
  roleNameSnapshot String
  fieldPersonaType FieldPersonaType @default(INDEPENDENT_VERIFIER)
  assuranceWeight  Float            @default(1.0)
  agentFullName    String
  agentPhoneNumber String
  agentPinHash     String?
  deviceId         String
  deviceModel      String?
  deviceOs         String?
  deviceSecretHash String?
  isActive         Boolean          @default(true)
  revokedAt        DateTime?
  revokedByUserId  String?          @db.Uuid
  revokeReason     String?
  lastSyncAt       DateTime?
  createdAt        DateTime         @default(now())

  // Identity & Competence Assurance
  assuranceStatus    ContractorAssuranceStatus @default(APPROVED)
  idDocumentType     String?
  idDocumentUrl      String?
  selfieImageUrl     String?
  selfieLeftUrl      String?
  selfieRightUrl     String?
  livenessScore      Float?
  livenessPassed     Boolean                   @default(false)
  livenessMetadata   Json?
  corenLicenseNumber String?
  experienceSummary  String?
  reviewedByUserId   String?                   @db.Uuid
  reviewedAt         DateTime?
  rejectionReason    String?

  project         Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  joinCode        ProjectJoinCode      @relation(fields: [joinCodeId], references: [id], onDelete: Restrict)
  role            Role                 @relation(fields: [roleId], references: [id], onDelete: Restrict)
  evidenceLogs    FieldEvidenceLog[]
  incidentReports IncidentReport[]
  workdayReports  WorkdayReport[]
  pushTokens      PushToken[]
  telemetryPings  SiteTelemetryPing[]
  notifications   MobileNotification[]
  wbsChatMessages WbsChatMessage[]

  @@index([projectId, roleId])
  @@index([projectId, assuranceStatus])
  @@index([deviceId])
}

model FacilityTranche {
  id                  String   @id @default(uuid()) @db.Uuid
  projectId           String   @db.Uuid
  trancheNumber       Int
  name                String // e.g., "Tranche 2 — Substructure & Box Culverts"
  allocatedAmountNgn  Decimal  @db.Decimal(18, 2)
  releasedAmountNgn   Decimal  @default(0) @db.Decimal(18, 2)
  targetCompletionPct Decimal  @db.Decimal(5, 2)
  isReleased          Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  project             Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  conditionsPrecedent ConditionPrecedent[]
  boqItems            BoqItem[]
  ipcClaims           IpcClaim[]

  @@unique([projectId, trancheNumber])
}

model ConditionPrecedent {
  id                    String                   @id @default(uuid()) @db.Uuid
  trancheId             String                   @db.Uuid
  referenceCode         String // e.g., "CP-01"
  description           String
  isMandatoryForRelease Boolean                  @default(true)
  status                ConditionPrecedentStatus @default(PENDING)
  evidenceDocumentUrl   String?
  verifiedAt            DateTime?
  waivedByUserId        String?                  @db.Uuid
  waiverReason          String?
  statusChangedAt       DateTime?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  tranche      FacilityTranche @relation(fields: [trancheId], references: [id], onDelete: Cascade)
  waivedByUser User?           @relation("WaivedConditions", fields: [waivedByUserId], references: [id], onDelete: SetNull)

  @@index([trancheId])
}

model BoqItem {
  id                               String  @id @default(uuid()) @db.Uuid
  projectId                        String  @db.Uuid
  trancheId                        String? @db.Uuid
  aiSuggestedTrancheId             String? @db.Uuid
  trancheMappingConfirmedByMonitor Boolean @default(false)

  wbsCode         String // e.g., "02.03.1"
  section         String // e.g., "BILL NO. 2 — DRAINAGE & CULVERTS"
  description     String
  unit            String // e.g., "m3", "m", "tons", "bags", "item"
  totalQuantity   Decimal @db.Decimal(14, 3)
  rateNgn         Decimal @db.Decimal(18, 2)
  budgetedCostNgn Decimal @db.Decimal(18, 2)

  isHoldPoint            Boolean  @default(false)
  isScheduledToday       Boolean  @default(false)
  planningTier           String   @default("UNBLOCKED_POOL") // PLAN_A | FALLBACK_BACKLOG | UNBLOCKED_POOL
  dailyTargetQuantity    Decimal? @db.Decimal(14, 3)
  expectedDeliverable    String?
  holdPointInstruction   String?
  isOpaqueLumpSum        Boolean  @default(false)
  opacityWarningReason   String?
  cumulativeCertifiedPct Decimal  @default(0) @db.Decimal(5, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project         Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tranche         FacilityTranche?          @relation(fields: [trancheId], references: [id], onDelete: SetNull)
  evidenceLogs    FieldEvidenceLog[]
  ipcLineItems    IpcLineItem[]
  incidentReports IncidentReport[]
  workdayReports  WorkdayReport[]
  morningBriefs   MorningDeliverableBrief[]
  reportQueries   ReportQuery[]
  wbsChatMessages WbsChatMessage[]

  @@unique([projectId, wbsCode])
  @@index([projectId, trancheId])
}

model FieldEvidenceLog {
  id               String            @id @default(uuid()) @db.Uuid
  projectId        String            @db.Uuid
  boqItemId        String?           @db.Uuid
  fieldSessionId   String            @db.Uuid
  clientCaptureId  String            @unique @db.Uuid
  reporterRoleId   String?           @db.Uuid
  reporterRoleName String            @default("Field Reporter")
  fieldPersonaType FieldPersonaType  @default(INDEPENDENT_VERIFIER)
  assuranceWeight  Float             @default(1.0)
  status           EvidenceLogStatus @default(AWAITING_CONFIRMATION)

  // Hardware GPS & Corridor Verification
  latitude              Float
  longitude             Float
  altitudeMeters        Float?
  gpsAccuracyMeters     Float
  isMockLocation        Boolean @default(false)
  isWithinGeofence      Boolean
  chainageKm            Float?
  chainageLabel         String? // e.g., "KM 14+200"
  corridorOffsetMeters  Float?
  verificationBadgeText String

  // Device Orientation & Cryptographic Provenance
  devicePitchDeg      Float?
  deviceRollDeg       Float?
  deviceAzimuthDeg    Float?
  deviceSignatureHash String
  integrityPassed     Boolean @default(true)
  integrityFlags      Json    @default("[]") // Array of flag strings

  // Speech / Text & Mandatory Human Confirmation
  rawTextNote               String?
  rawWhisperTranscript      String?
  confirmedSummary          String?
  confirmedQuantities       Json    @default("[]") // Array of ExtractedQuantityItem
  siteBlockers              Json    @default("[]") // Array of strings
  visionObservationSummary  String?
  wasEditedByAgent          Boolean @default(false)
  confirmationSignatureHash String?

  capturedAtDevice DateTime
  syncedAtServer   DateTime  @default(now())
  confirmedAt      DateTime?

  project          Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  boqItem          BoqItem?          @relation(fields: [boqItemId], references: [id], onDelete: SetNull)
  fieldSession     FieldAgentSession @relation(fields: [fieldSessionId], references: [id], onDelete: Restrict)
  mediaAttachments EvidenceMedia[]

  @@index([projectId, status])
  @@index([projectId, boqItemId])
  @@index([projectId, reporterRoleId])
}

model EvidenceMedia {
  id              String    @id @default(uuid()) @db.Uuid
  evidenceLogId   String    @db.Uuid
  mediaType       MediaType
  objectKey       String
  fileUrl         String?
  mimeType        String
  byteSize        Int
  sha256FileHash  String
  perceptualHash  String? // 64-bit pHash hex/binary string for duplicate site photo screening
  durationSeconds Float?
  createdAt       DateTime  @default(now())

  evidenceLog FieldEvidenceLog @relation(fields: [evidenceLogId], references: [id], onDelete: Cascade)

  @@index([evidenceLogId])
  @@index([perceptualHash])
  @@index([sha256FileHash])
}

model IpcClaim {
  id                    String         @id @default(uuid()) @db.Uuid
  projectId             String         @db.Uuid
  trancheId             String         @db.Uuid
  ipcNumber             Int
  periodStart           DateTime
  periodEnd             DateTime
  contractorCoverNote   String?
  totalClaimedAmountNgn Decimal        @db.Decimal(18, 2)
  totalCertifiedNgn     Decimal?       @db.Decimal(18, 2)
  status                IpcClaimStatus @default(SUBMITTED)
  aiExecutiveSummary    String?
  submittedByUserId     String         @db.Uuid
  // AZURE_OPENAI or RULES_ENGINE; null until reconciliation has run.
  ratingEngine          String?
  ratingEngineDetail    String?
  reconciledAt          DateTime?
  submittedAt           DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  project             Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tranche             FacilityTranche         @relation(fields: [trancheId], references: [id], onDelete: Restrict)
  submittedByUser     User                    @relation("SubmittedIpcClaims", fields: [submittedByUserId], references: [id])
  lineItems           IpcLineItem[]
  supportingDocuments IpcSupportingDocument[]
  valuationReports    ValuationReport[]

  @@unique([projectId, ipcNumber])
  @@index([projectId, status])
  @@index([trancheId, status])
}

model IpcLineItem {
  id         String @id @default(uuid()) @db.Uuid
  ipcClaimId String @db.Uuid
  boqItemId  String @db.Uuid

  previousCertifiedPct Decimal @default(0) @db.Decimal(5, 2)
  contractorClaimedPct Decimal @db.Decimal(5, 2)
  contractorClaimedNgn Decimal @db.Decimal(18, 2)
  contractorRemarks    String?

  // AI Auditor Co-Pilot Output (Never legally certifies completion %)
  aiEvidenceRating             EvidenceStrengthRating @default(UNSUPPORTED)
  aiRationale                  String?
  visitPlannerFlag             Boolean                @default(false)
  visitPlannerReason           String?
  missingHoldPointFlag         Boolean                @default(false)
  highestCorroboratingRoleName String?
  highestCorroboratingWeight   Float?
  corroboratingEvidenceLogIds  Json                   @default("[]")
  evidenceQuantityTotal        Decimal?               @db.Decimal(18, 3)
  evidenceCoveragePct          Decimal?               @db.Decimal(9, 2)
  ratingEngine                 String?
  ruleCapsApplied              Json                   @default("[]")

  // Human Monitor (QS / COREN) Certified Valuation
  monitorCertifiedPct Decimal? @db.Decimal(5, 2)
  monitorCertifiedNgn Decimal? @db.Decimal(18, 2)
  monitorRemarks      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ipcClaim IpcClaim       @relation(fields: [ipcClaimId], references: [id], onDelete: Cascade)
  boqItem  BoqItem        @relation(fields: [boqItemId], references: [id], onDelete: Restrict)
  queries  MonitorQuery[]

  @@unique([ipcClaimId, boqItemId])
}

model IpcSupportingDocument {
  id         String    @id @default(uuid()) @db.Uuid
  ipcClaimId String    @db.Uuid
  boqItemId  String?   @db.Uuid
  title      String
  mediaType  MediaType
  objectKey  String
  fileUrl    String?
  uploadedAt DateTime  @default(now())

  ipcClaim IpcClaim @relation(fields: [ipcClaimId], references: [id], onDelete: Cascade)

  @@index([ipcClaimId])
}

model MonitorQuery {
  id                          String      @id @default(uuid()) @db.Uuid
  ipcLineItemId               String      @db.Uuid
  status                      QueryStatus @default(OPEN)
  queryReason                 String
  requestedProofTypes         Json        @default("[]")
  contractorResponseText      String?
  revisedClaimedCumulativePct Decimal?    @db.Decimal(5, 2)
  attachedDocumentsJson       Json        @default("[]")
  raisedByUserId              String?     @db.Uuid
  respondedByUserId           String?     @db.Uuid
  resolvedByUserId            String?     @db.Uuid
  resolutionNote              String?
  createdAt                   DateTime    @default(now())
  respondedAt                 DateTime?
  resolvedAt                  DateTime?

  ipcLineItem     IpcLineItem @relation(fields: [ipcLineItemId], references: [id], onDelete: Cascade)
  raisedByUser    User?       @relation("RaisedMonitorQueries", fields: [raisedByUserId], references: [id], onDelete: SetNull)
  respondedByUser User?       @relation("RespondedMonitorQueries", fields: [respondedByUserId], references: [id], onDelete: SetNull)
  resolvedByUser  User?       @relation("ResolvedMonitorQueries", fields: [resolvedByUserId], references: [id], onDelete: SetNull)

  @@index([ipcLineItemId, status])
}

model ValuationReport {
  id                            String                  @id @default(uuid()) @db.Uuid
  ipcClaimId                    String                  @db.Uuid
  revisionNumber                Int                     @default(1)
  certifiedByUserId             String                  @db.Uuid
  trancheRecommendation         MonitorRecommendation
  recommendedReleaseAmountNgn   Decimal                 @db.Decimal(18, 2)
  recommendedHoldbackAmountNgn  Decimal                 @db.Decimal(18, 2)
  executiveCertificationSummary String
  // Snapshots copied from the certifying User at certification time, never from the request.
  certifierFullName             String
  certifierLicenseType          ProfessionalLicenseType
  certifierLicenseNumber        String
  totalClaimedNgn               Decimal                 @db.Decimal(18, 2)
  totalCertifiedNgn             Decimal                 @db.Decimal(18, 2)
  reportPdfObjectKey            String?
  reportPdfUrl                  String?
  certifiedAt                   DateTime                @default(now())
  supersededAt                  DateTime?

  ipcClaim         IpcClaim          @relation(fields: [ipcClaimId], references: [id], onDelete: Cascade)
  certifiedByUser  User              @relation("CertifiedByMonitor", fields: [certifiedByUserId], references: [id])
  trancheDecisions TrancheDecision[]

  @@unique([ipcClaimId, revisionNumber])
}

model TrancheDecision {
  id                            String             @id @default(uuid()) @db.Uuid
  valuationReportId             String             @db.Uuid
  decidedByUserId               String             @db.Uuid
  decision                      LenderDecisionType
  approvedDisbursementAmountNgn Decimal            @db.Decimal(18, 2)
  heldBackAmountNgn             Decimal            @db.Decimal(18, 2)
  creditCommitteeReference      String?
  approverNotes                 String?
  // Set on a reversal record: the decision it cancels. Reversal amounts are negative.
  reversesDecisionId            String?            @unique @db.Uuid
  cpSnapshotJson                Json               @default("[]")
  decidedAt                     DateTime           @default(now())

  valuationReport  ValuationReport  @relation(fields: [valuationReportId], references: [id], onDelete: Cascade)
  decidedByUser    User             @relation("DecidedByLender", fields: [decidedByUserId], references: [id])
  reversesDecision TrancheDecision? @relation("DecisionReversal", fields: [reversesDecisionId], references: [id], onDelete: Restrict)
  reversedBy       TrancheDecision? @relation("DecisionReversal")

  @@index([valuationReportId])
}

model AuditLog {
  id               String          @id @default(uuid()) @db.Uuid
  tenantId         String          @db.Uuid
  projectId        String?         @db.Uuid
  seq              BigInt
  actorType        AuditActorType
  actorId          String
  actorDisplayName String
  action           AuditActionType
  summaryText      String
  payload          Json
  previousHash     String
  entryHash        String          @unique
  createdAt        DateTime        @default(now())

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([tenantId, projectId, seq])
  @@index([projectId, seq])
  @@index([tenantId, seq])
}

model PushToken {
  id             String   @id @default(uuid()) @db.Uuid
  deviceToken    String   @unique
  devicePlatform String // ANDROID, IOS, WEB
  appVersion     String?
  sessionId      String?  @db.Uuid
  userId         String?  @db.Uuid
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  session FieldAgentSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User?              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([userId])
  @@map("push_tokens")
}

model IncidentReport {
  id                          String    @id @default(uuid()) @db.Uuid
  projectId                   String    @db.Uuid
  reporterSessionId           String    @db.Uuid
  wbsItemId                   String?   @db.Uuid
  category                    String // WHISTLEBLOWING, SITE_EMERGENCY, CRITICAL_DELAY, MATERIAL_FAILURE
  severity                    String    @default("HIGH") // CRITICAL, HIGH, MEDIUM, LOW
  title                       String
  description                 String    @db.Text
  isConfidentialWhistleblower Boolean   @default(false)
  status                      String    @default("OPEN") // OPEN, UNDER_REVIEW, ACTION_TAKEN, DISMISSED
  photoEvidenceUrls           String[]
  voiceNoteUrl                String?
  deviceGpsCoordinates        Json?
  createdAt                   DateTime  @default(now())
  resolvedAt                  DateTime?

  project         Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reporterSession FieldAgentSession @relation(fields: [reporterSessionId], references: [id], onDelete: Cascade)
  boqItem         BoqItem?          @relation(fields: [wbsItemId], references: [id], onDelete: SetNull)

  @@index([projectId, category])
  @@index([projectId, status])
  @@map("incident_reports")
}

model WorkdayReport {
  id                 String    @id @default(uuid()) @db.Uuid
  projectId          String    @db.Uuid
  reporterSessionId  String    @db.Uuid
  wbsItemId          String    @db.Uuid
  workdayDate        String // YYYY-MM-DD
  status             String    @default("STAGED_UNVERIFIED") // STAGED_UNVERIFIED, READY_FOR_AI, EXTRACTED, CONFIRMED, SYNCED
  revisionNumber     Int       @default(1)
  parentReportId     String?   @db.Uuid
  resolvedQueryId    String?   @db.Uuid
  summaryText        String    @db.Text
  reportedQuantity   Decimal   @default(0) @db.Decimal(14, 3)
  unitOfMeasure      String
  isHoldPointClaimed Boolean   @default(false)
  evidenceItems      Json // Array of captured photos, voice notes, captions
  voiceNoteUrl       String?
  submissionGeotag   Json?
  aiParsedConfidence Float?
  aiReasoning        String?   @db.Text
  humanConfirmedAt   DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  project         Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reporterSession FieldAgentSession @relation(fields: [reporterSessionId], references: [id], onDelete: Cascade)
  boqItem         BoqItem           @relation(fields: [wbsItemId], references: [id], onDelete: Cascade)
  parentReport    WorkdayReport?    @relation("WorkdayReportRevisions", fields: [parentReportId], references: [id], onDelete: SetNull)
  revisions       WorkdayReport[]   @relation("WorkdayReportRevisions")
  queries         ReportQuery[]
  chatMessages    WbsChatMessage[]

  @@index([projectId, wbsItemId, workdayDate])
  @@index([projectId, status])
  @@index([parentReportId])
  @@map("workday_reports")
}

model SiteTelemetryPing {
  id                  String   @id @default(uuid()) @db.Uuid
  projectId           String   @db.Uuid
  fieldSessionId      String   @db.Uuid
  wbsItemId           String?  @db.Uuid
  latitude            Float
  longitude           Float
  accuracyMeters      Float?
  altitudeMeters      Float?
  isMocked            Boolean  @default(false)
  isWithinGeofence    Boolean?
  chainageLabel       String?
  distanceMeters      Float?
  pingSource          String   @default("HOURLY_TELEMETRY") // HOURLY_TELEMETRY | REPORT_SUBMISSION | MANUAL_CHECKIN
  deviceSignatureHash String
  capturedAtDevice    DateTime
  syncedAtServer      DateTime @default(now())

  project      Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fieldSession FieldAgentSession @relation(fields: [fieldSessionId], references: [id], onDelete: Cascade)

  @@index([projectId, capturedAtDevice])
  @@index([fieldSessionId, capturedAtDevice])
  @@map("site_telemetry_pings")
}

model MorningDeliverableBrief {
  id                  String   @id @default(uuid()) @db.Uuid
  projectId           String   @db.Uuid
  boqItemId           String   @db.Uuid
  workdayDate         String // YYYY-MM-DD
  planningTier        String   @default("PLAN_A")
  headline            String
  expectedDeliverable String   @db.Text
  reportingChecklist  Json     @default("[]")
  dailyTargetQuantity Decimal? @db.Decimal(14, 3)
  generatedByAi       Boolean  @default(false)
  createdAt           DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  boqItem BoqItem @relation(fields: [boqItemId], references: [id], onDelete: Cascade)

  @@unique([projectId, boqItemId, workdayDate])
  @@index([projectId, workdayDate])
  @@map("morning_deliverable_briefs")
}

model MobileNotification {
  id             String                 @id @default(uuid()) @db.Uuid
  projectId      String                 @db.Uuid
  fieldSessionId String?                @db.Uuid
  type           MobileNotificationType
  actionType     NotificationActionType @default(NONE)
  requiresAction Boolean                @default(false)
  title          String
  message        String                 @db.Text
  metadata       Json                   @default("{}")
  isRead         Boolean                @default(false)
  readAt         DateTime?
  createdAt      DateTime               @default(now())

  project      Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fieldSession FieldAgentSession? @relation(fields: [fieldSessionId], references: [id], onDelete: Cascade)

  @@index([projectId, isRead, createdAt])
  @@index([fieldSessionId, isRead, createdAt])
  @@map("mobile_notifications")
}

model ReportQuery {
  id                String    @id @default(uuid()) @db.Uuid
  projectId         String    @db.Uuid
  boqItemId         String    @db.Uuid
  workdayReportId   String?   @db.Uuid
  ipcLineItemId     String?   @db.Uuid
  raisedByUserId    String?   @db.Uuid
  source            String    @default("MONITOR") // MONITOR | AI_OMISSION_CHECK
  status            String    @default("OPEN") // OPEN | RESUBMITTED | RESOLVED
  monitorComment    String?   @db.Text
  aiOmissionPayload Json?
  createdAt         DateTime  @default(now())
  respondedAt       DateTime?
  resolvedAt        DateTime?

  project       Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  boqItem       BoqItem          @relation(fields: [boqItemId], references: [id], onDelete: Cascade)
  workdayReport WorkdayReport?   @relation(fields: [workdayReportId], references: [id], onDelete: SetNull)
  raisedByUser  User?            @relation("RaisedReportQueries", fields: [raisedByUserId], references: [id], onDelete: SetNull)
  chatMessages  WbsChatMessage[]

  @@index([projectId, boqItemId, status])
  @@index([workdayReportId])
  @@map("report_queries")
}

model WbsChatMessage {
  id              String   @id @default(uuid()) @db.Uuid
  projectId       String   @db.Uuid
  boqItemId       String   @db.Uuid
  workdayReportId String?  @db.Uuid
  reportQueryId   String?  @db.Uuid
  fieldSessionId  String?  @db.Uuid
  senderName      String
  senderRole      String // AI_CO_PILOT | MONITOR | ENGINEER | INSPECTOR
  messageType     String // AI_QUERY | MONITOR_QUERY | QUERY_RESPONSE | TEXT_COMMENT | PHOTO | VOICE_NOTE
  textContent     String?  @db.Text
  mediaUrls       Json     @default("[]")
  latitude        Float?
  longitude       Float?
  chainageLabel   String?
  createdAt       DateTime @default(now())

  project       Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  boqItem       BoqItem            @relation(fields: [boqItemId], references: [id], onDelete: Cascade)
  workdayReport WorkdayReport?     @relation(fields: [workdayReportId], references: [id], onDelete: SetNull)
  reportQuery   ReportQuery?       @relation(fields: [reportQueryId], references: [id], onDelete: SetNull)
  fieldSession  FieldAgentSession? @relation(fields: [fieldSessionId], references: [id], onDelete: SetNull)

  @@index([projectId, boqItemId, createdAt])
  @@index([reportQueryId])
  @@map("wbs_chat_messages")
}

model WebNotification {
  id                  String   @id @default(uuid()) @db.Uuid
  projectId           String   @db.Uuid
  targetPermissionKey String   @default("reports:view_all")
  targetRoleId        String?  @db.Uuid
  category            String // REPORT_RESUBMITTED | CONFLICT_FLAG | CONTRACTOR_ONBOARDING | TRANCHE_DISBURSEMENT | MONITOR_QUERY | AI_OMISSION_FLAG
  title               String
  description         String   @db.Text
  actionUrl           String?
  metadata            Json     @default("{}")
  createdAt           DateTime @default(now())

  project Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reads   WebNotificationRead[]

  @@index([projectId, targetPermissionKey, createdAt])
  @@map("web_notifications")
}

model WebNotificationRead {
  notificationId String   @db.Uuid
  userId         String   @db.Uuid
  readAt         DateTime @default(now())

  notification WebNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([notificationId, userId])
  @@index([userId])
  @@map("web_notification_reads")
}
