}

// ---------------------------------------------------------------------------
// Phase 15: Certificate of Completion and closure governance
// ---------------------------------------------------------------------------

enum CompletionCertificateStatus {
  DRAFT
  PENDING_SIGNATURES
  ISSUED
  REVOKED
}

enum ClosureChecklistList {
  BEFORE_CLOSE
  BEFORE_ARCHIVE
}

enum ClosureChecklistItemStatus {
  PENDING
  DONE
  WAIVED
}

enum ContractorRatingStage {
  COMPLETION
  POST_CLOSURE
}

enum LessonStatus {
  DRAFT
  PUBLISHED
}

enum ClosurePackStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

/// The Certificate of Completion. At most one non-revoked certificate per project (hand-written
/// partial unique index completion_certificates_one_live_per_project).
model CompletionCertificate {
  id                     String                      @id @default(uuid()) @db.Uuid
  projectId              String                      @db.Uuid
  certificateNumber      String
  status                 CompletionCertificateStatus @default(DRAFT)
  scopeSummary           String                      @db.Text
  // YYYY-MM-DD in the project zone
  completionDate         String
  // Redesign R4d: the accepted final evaluation visit the certificate was drafted on.
  finalEvaluationVisitId String?                     @db.Uuid
  // The issued PDF in the register (COMPLETION_CERTIFICATE).
  documentId             String?                     @db.Uuid
  // The signatory slots as configured when drafted.
  slotsJson              Json                        @default("[]")
  issuedAt               DateTime?
  revokedAt              DateTime?
  revokedReason          String?
  revokedByUserId        String?                     @db.Uuid
  createdByUserId        String                      @db.Uuid
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt

  project    Project                          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  document   ProjectDocument?                 @relation("CompletionCertificateDocument", fields: [documentId], references: [id], onDelete: SetNull)
  signatures CompletionCertificateSignature[]

  @@unique([projectId, certificateNumber])
  @@index([projectId, status])
  @@map("completion_certificates")
}

/// One signature in one slot. The beneficiary slot has no user: an officer records the signed paper
/// copy (evidenceDocumentId) and attests (recordedByUserId).
model CompletionCertificateSignature {
  id                 String   @id @default(uuid()) @db.Uuid
  certificateId      String   @db.Uuid
  slotKey            String
  slotLabel          String
  userId             String?  @db.Uuid
  roleId             String?  @db.Uuid
  organizationId     String?  @db.Uuid
  isBeneficiary      Boolean  @default(false)
  beneficiaryName    String?
  beneficiaryRole    String?
  evidenceDocumentId String?  @db.Uuid
  recordedByUserId   String?  @db.Uuid
  statement          String
  statementHash      String
  signedAt           DateTime @default(now())

  certificate      CompletionCertificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)
  evidenceDocument ProjectDocument?      @relation("CocSignatureEvidence", fields: [evidenceDocumentId], references: [id], onDelete: Restrict)

  @@unique([certificateId, slotKey])
  @@unique([certificateId, userId])
  @@map("completion_certificate_signatures")
}

/// Stored state of a closure checklist item (the item itself comes from the type snapshot).
model ClosureChecklistItemState {
  id                String                     @id @default(uuid()) @db.Uuid
  projectId         String                     @db.Uuid
  list              ClosureChecklistList
  itemKey           String
  status            ClosureChecklistItemStatus @default(PENDING)
  completedByUserId String?                    @db.Uuid
  completedAt       DateTime?
  notes             String?
  waivedReason      String?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, list, itemKey])
  @@map("closure_checklist_items")
}

model ContractorPerformanceRating {
  id                  String                @id @default(uuid()) @db.Uuid
  projectId           String                @db.Uuid
  projectContractorId String                @db.Uuid
  stage               ContractorRatingStage
  // [{ key, label, score (1-5), comment }]
  criteriaJson        Json
  overallScore        Decimal               @db.Decimal(4, 2)
  comments            String?
  ratedByUserId       String                @db.Uuid
  createdAt           DateTime              @default(now())

  project           Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectContractor ProjectContractor @relation(fields: [projectContractorId], references: [id], onDelete: Cascade)

  @@unique([projectContractorId, stage, ratedByUserId])
  @@index([projectId])
  @@map("contractor_performance_ratings")
}

model LessonLearned {
  id                   String       @id @default(uuid()) @db.Uuid
  tenantId             String       @db.Uuid
  projectId            String       @db.Uuid
  category             String
  title                String
  description          String       @db.Text
  recommendation       String       @db.Text
  stage                String
  tags                 String[]     @default([])
  status               LessonStatus @default(DRAFT)
  sharedWithContractor Boolean      @default(false)
  createdByUserId      String       @db.Uuid
  publishedAt          DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([projectId])
  @@map("lessons_learned")
}

model ClosurePackExport {
  id                String            @id @default(uuid()) @db.Uuid
  projectId         String            @db.Uuid
  status            ClosurePackStatus @default(QUEUED)
  documentId        String?           @db.Uuid
  byteSize          Int?
  entryCount        Int?
  chainVerified     Boolean?
  requestedByUserId String            @db.Uuid
  createdAt         DateTime          @default(now())
  startedAt         DateTime?
  finishedAt        DateTime?
  error             String?

  project  Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  document ProjectDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([status])
  @@map("closure_pack_exports")
}

// ---------------------------------------------------------------------------
// Phase 16: programme KPIs
// ---------------------------------------------------------------------------

/// A project's KPI figures for one period (the current month, recomputed daily by `kpi-snapshot`;
/// earlier months are backfilled once for period-based KPIs). Only tracked KPIs are stored.
model KpiSnapshot {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  projectId   String   @db.Uuid
  kpiKey      String
  periodStart String // YYYY-MM-DD, first day of the month
  periodEnd   String // YYYY-MM-DD, inclusive (the computation day for the current month)
  numerator   Decimal  @db.Decimal(20, 4)
  denominator Decimal  @db.Decimal(20, 4)
  value       Decimal? @db.Decimal(20, 4)
  computedAt  DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, kpiKey, periodStart])
  @@index([tenantId, periodStart])
  @@map("kpi_snapshots")
}

// ---------------------------------------------------------------------------
// Redesign R1b: payment record. Payments are made outside the platform (later fed by an ERP);
// the platform records them, holds retention against them and flags exceptions (e.g. a final
// payment before the Certificate of Completion). A wrong entry is voided with a reason, never deleted.
// ---------------------------------------------------------------------------

enum PaymentKind {
  INTERIM
  FINAL
  RETENTION_RELEASE
}

enum PaymentSource {
  MANUAL
  ERP
}

model ProjectPayment {
  id                      String        @id @default(uuid()) @db.Uuid
  projectId               String        @db.Uuid
  kind                    PaymentKind
  // YYYY-MM-DD in the project zone.
  paidOn                  String
  grossAmountNgn          Decimal       @db.Decimal(18, 2)
  // Held back from this payment (0 for a retention release).
  retentionHeldNgn        Decimal       @default(0) @db.Decimal(18, 2)
  netAmountNgn            Decimal       @db.Decimal(18, 2)
  // Set when the held amount differs from gross x the project's retention percentage.
  retentionOverrideReason String?
  reference               String
  description             String?
  source                  PaymentSource @default(MANUAL)
  // ERP document id; unique per project so an ERP feed can retry safely.
  externalReference       String?
  // Exception codes computed when recorded (e.g. FINAL_BEFORE_COC).
  exceptionsJson          Json          @default("[]")
  recordedByUserId        String?       @db.Uuid
  recordedByName          String
  createdAt               DateTime      @default(now())
  voidedAt                DateTime?
  voidedByName            String?
  voidReason              String?
  // Redesign R6d (D-R6.23): the sprint the payment is for, optional. A named sprint cannot be removed.
  sprintId                String?       @db.Uuid

  project Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sprint  ProjectSprint? @relation(fields: [sprintId], references: [id], onDelete: Restrict)

  @@unique([projectId, externalReference])
  @@index([projectId, paidOn])
  @@index([projectId, sprintId])
  @@map("project_payments")
}

// ---------------------------------------------------------------------------
// Redesign R2: facility catalogue, facility units, sprints (spec section 5)
// ---------------------------------------------------------------------------

enum FacilityArchetype {
  BUILDING_WORKS
  SUPPLY_INSTALLATION
  UTILITIES
  EXTERNAL_WORKS
}

// Tenant catalogue entry (provisioned from DEFAULT_FACILITIES). A retired facility stays on the
// projects that use it and is hidden from pickers and the workbook. The code is locked once used.
model Facility {
  id         String            @id @default(uuid()) @db.Uuid
  tenantId   String            @db.Uuid
  code       String
  name       String
  // R3: plural for form placeholders when the simple English plural is wrong.
  pluralName String?
  category   String?
  archetype  FacilityArchetype
  isRetired  Boolean           @default(false)
  sortOrder  Int               @default(0)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  units    FacilityUnit[]
  subForms FacilitySubForm[]

  @@unique([tenantId, code])
  @@index([tenantId, isRetired])
  @@map("facilities")
}

// A named period of the project with deliverables (D-R2.4). Numbers follow date order (1…n);
// overlaps are refused; status is derived from the dates (R4 adds verification).
model ProjectSprint {
  id                       String                     @id @default(uuid()) @db.Uuid
  projectId                String                     @db.Uuid
  number                   Int
  name                     String
  // YYYY-MM-DD in the project zone, both days included.
  startDate                String
  endDate                  String
  deliverables             String                     @default("") @db.Text
  // Redesign R4e (D-R4.31): the M&E verification of the sprint once it has started (normally after it ends).
  verificationOutcome      SprintVerificationOutcome?
  verifiedAt               DateTime?
  verifiedByUserId         String?                    @db.Uuid
  verificationNotes        String?                    @db.Text
  firstVerifiedAt          DateTime?
  verificationDueAlertedAt DateTime?
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt

  project            Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  startingUnits      FacilityUnit[]      @relation("UnitStartSprint")
  endingUnits        FacilityUnit[]      @relation("UnitEndSprint")
  visitFormSnapshots VisitFormSnapshot[]
  visits             Visit[]
  payments           ProjectPayment[]

  @@unique([projectId, number])
  @@map("project_sprints")
}

// One physical instance of a catalogue facility on a project ("Ground floor male toilet"). Supply
// units carry a planned quantity. Its scope lines take their planned window from its sprints.
model FacilityUnit {
  id                   String   @id @default(uuid()) @db.Uuid
  projectId            String   @db.Uuid
  facilityId           String   @db.Uuid
  // The workbook "Unit ID", unique per project (e.g. U01).
  code                 String
  label                String
  plannedQuantity      Decimal? @db.Decimal(14, 3)
  quantityUnit         String?
  // Redesign R4d (D-R4.26): progress observed by the latest accepted visit (null = none yet).
  progressPct          Decimal? @db.Decimal(5, 2)
  progressAsOf         String?
  progressSubmissionId String?  @db.Uuid
  startSprintId        String?  @db.Uuid
  endSprintId          String?  @db.Uuid
  sortOrder            Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  facility    Facility       @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  startSprint ProjectSprint? @relation("UnitStartSprint", fields: [startSprintId], references: [id], onDelete: SetNull)
  endSprint   ProjectSprint? @relation("UnitEndSprint", fields: [endSprintId], references: [id], onDelete: SetNull)
  lines       BoqItem[]

  @@unique([projectId, code])
  @@index([facilityId])
  @@index([startSprintId])
  @@index([endSprintId])
  @@map("facility_units")
}

// ---------------------------------------------------------------------------
// Redesign R3: form library (fixed sections, facility sub-forms, visit form templates). Each is
// versioned: a version used by a stored VisitFormSnapshot is never edited; saving makes version + 1.
// ---------------------------------------------------------------------------

enum VisitKind {
  MOBILISATION_CHECK
  BASELINE
  ROUTINE
  QUARTERLY_ME
  FINAL_EVALUATION
  POST_CLOSURE_EVALUATION
  AD_HOC
}

enum FormSubFormSubject {
  ARCHETYPE
  FACILITY
}

// A reusable fixed section ("Health & safety"), versioned by code. fieldsJson: FormField[].
model FormSection {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.Uuid
  code            String
  version         Int      @default(1)
  title           String
  description     String?
  fieldsJson      Json
  isArchived      Boolean  @default(false)
  createdByUserId String?  @db.Uuid
  createdAt       DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code, version])
  @@index([tenantId, isArchived])
  @@map("form_sections")
}

// A facility sub-form: the archetype default (subject ARCHETYPE) or a facility's own override
// (subject FACILITY). subjectKey is "ARCHETYPE:<archetype>" or "FACILITY:<facilityId>", written by
// the service. Hand-written CHECK facility_subforms_subject_check keeps subject and columns in step.
model FacilitySubForm {
  id              String             @id @default(uuid()) @db.Uuid
  tenantId        String             @db.Uuid
  subject         FormSubFormSubject
  archetype       FacilityArchetype?
  facilityId      String?            @db.Uuid
  subjectKey      String
  version         Int                @default(1)
  fieldsJson      Json
  isArchived      Boolean            @default(false)
  createdByUserId String?            @db.Uuid
  createdAt       DateTime           @default(now())

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  facility Facility? @relation(fields: [facilityId], references: [id], onDelete: Restrict)

  @@unique([tenantId, subjectKey, version])
  @@index([facilityId])
  @@map("facility_subforms")
}

// A visit form template for one visit kind: ordered blocks (sections by code, one FACILITIES slot).
model VisitFormTemplate {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @db.Uuid
  code            String
  version         Int       @default(1)
  name            String
  visitKind       VisitKind
  layoutJson      Json
  isArchived      Boolean   @default(false)
  createdByUserId String?   @db.Uuid
  createdAt       DateTime  @default(now())

  tenant    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  snapshots VisitFormSnapshot[]

  @@unique([tenantId, code, version])
  @@index([tenantId, visitKind])
  @@map("visit_form_templates")
}

// Redesign R3c: a frozen, self-contained visit form (D-R3.15). R4 links it from Visit.formSnapshotId and
// creates it in the transaction that assigns the visit; a stored snapshot is never mutated. Its
// template, section and sub-form ids mark those versions as used (they are never edited again).
model VisitFormSnapshot {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @db.Uuid
  projectId     String    @db.Uuid
  visitKind     VisitKind
  // YYYY-MM-DD in the project zone
  visitDate     String
  sprintId      String?   @db.Uuid
  templateId    String    @db.Uuid
  sectionIds    String[]  @db.Uuid
  subFormIds    String[]  @db.Uuid
  snapshotJson  Json
  // SHA-256 of canonicalVisitFormSnapshot (builtAt excluded)
  contentSha256 String
  schemaVersion Int
  builtAt       DateTime
  builtByUserId String?   @db.Uuid

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project  Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sprint   ProjectSprint?    @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  template VisitFormTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  visits   Visit[]

  @@index([projectId])
  @@index([templateId])
  @@map("visit_form_snapshots")
}

// ---------------------------------------------------------------------------
// Redesign R4: scheduled visits (spec 8). A visit is proposed from the type plan (or created by
// hand), published to its officers with a frozen form (VisitFormSnapshot), answered from the field
// app (VisitSubmission, R4c) and accepted through the REPORT approval chain (R4d).
// ---------------------------------------------------------------------------

enum VisitStatus {
  PROPOSED
  PLANNED
  IN_PROGRESS
  SUBMITTED
  RETURNED
  APPROVED
  MISSED
  CANCELLED
}

enum VisitConfirmation {
  UNCONFIRMED
  CONFIRMED
  DECLINED
}

enum VisitOrigin {
  PLAN
  MANUAL
  UNSCHEDULED
}

model Visit {
  id                    String            @id @default(uuid()) @db.Uuid
  projectId             String            @db.Uuid
  visitKind             VisitKind
  status                VisitStatus       @default(PROPOSED)
  origin                VisitOrigin       @default(MANUAL)
  // "<rule key>:<date>" for plan visits, so regeneration never duplicates (D-R4.11).
  generatorKey          String?
  // YYYY-MM-DD in the project zone. The original never changes once published (D-R4.4).
  originalPlannedDate   String
  plannedDate           String
  sprintId              String?           @db.Uuid
  confirmation          VisitConfirmation @default(UNCONFIRMED)
  confirmedAt           DateTime?
  // The frozen form (null while PROPOSED); formHash = its contentSha256 (register: formSnapshotId + formHash).
  formSnapshotId        String?           @db.Uuid
  formHash              String?
  formAssembledAt       DateTime?
  // AD_HOC: the facilities to check.
  pickedFacilityIds     String[]          @db.Uuid
  // planned date + the type's submissionDeadlineDays (YYYY-MM-DD).
  submissionDeadline    String?
  // Applied officer moves and accepted proposals.
  rescheduleCount       Int               @default(0)
  publishedAt           DateTime?
  publishedByUserId     String?           @db.Uuid
  cancelledAt           DateTime?
  cancelledReason       String?
  cancelledByUserId     String?           @db.Uuid
  missedAt              DateTime?
  createdByUserId       String?           @db.Uuid
  // Unscheduled visits from the field app (idempotent).
  clientVisitId         String?           @unique @db.Uuid
  // R4c check-in (D-R4.19): recorded and flagged, never refused over GPS.
  checkInAt             DateTime?
  checkInGeotag         Json?
  checkInGeofenceStatus GeofenceStatus?
  checkInByUserId       String?           @db.Uuid
  clientCheckInId       String?           @unique @db.Uuid
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  project      Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sprint       ProjectSprint?     @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  formSnapshot VisitFormSnapshot? @relation(fields: [formSnapshotId], references: [id], onDelete: Restrict)
  assignees    VisitAssignee[]
  dateChanges  VisitDateChange[]
  responses    VisitResponse[]
  submissions  VisitSubmission[]
  comments     VisitComment[]

  @@unique([projectId, generatorKey])
  @@index([projectId, plannedDate])
  @@index([status, plannedDate])
  @@map("visits")
}

model VisitAssignee {
  id        String   @id @default(uuid()) @db.Uuid
  visitId   String   @db.Uuid
  userId    String   @db.Uuid
  isLead    Boolean  @default(false)
  createdAt DateTime @default(now())

  visit Visit @relation(fields: [visitId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([visitId, userId])
  @@index([userId])
  @@map("visit_assignees")
}

// Redesign R4b (D-R4.4, D-R4.14): every change of a visit's date. One PENDING proposal per visit
// (hand-written partial unique index visit_date_changes_one_pending_per_visit).
enum VisitDateChangeKind {
  MANAGER_MOVE
  OFFICER_MOVE
  OFFICER_PROPOSAL
}

enum VisitDateChangeStatus {
  APPLIED
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

model VisitDateChange {
  id              String                @id @default(uuid()) @db.Uuid
  visitId         String                @db.Uuid
  kind            VisitDateChangeKind
  status          VisitDateChangeStatus
  fromDate        String
  toDate          String
  comment         String?
  byUserId        String?               @db.Uuid
  byName          String
  // Officer responses from the phone's outbox (idempotent).
  clientActionId  String?               @unique @db.Uuid
  decidedByUserId String?               @db.Uuid
  decidedByName   String?
  decidedAt       DateTime?
  decisionNote    String?
  createdAt       DateTime              @default(now())

  visit Visit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@index([visitId, createdAt])
  @@map("visit_date_changes")
}

// Redesign R4b (D-R4.14): every officer response, idempotent on the phone's clientActionId.
enum VisitResponseAction {
  CONFIRM
  MOVE
  PROPOSE
  DECLINE
}

model VisitResponse {
  id             String              @id @default(uuid()) @db.Uuid
  visitId        String              @db.Uuid
  clientActionId String              @unique @db.Uuid
  action         VisitResponseAction
  userId         String              @db.Uuid
  userName       String
  date           String?
  comment        String?
  dateChangeId   String?             @db.Uuid
  createdAt      DateTime            @default(now())

  visit Visit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@index([visitId, createdAt])
  @@map("visit_responses")
}

// Redesign R4c (D-R4.1, D-R4.20): what an officer sent for a visit. A returned submission is followed
// by a resubmission; at most one is live (PENDING_APPROVAL or APPROVED), hand-written partial unique
// index visit_submissions_one_live_per_visit.
enum VisitSubmissionStatus {
  PENDING_APPROVAL
  RETURNED
  APPROVED
}

enum VisitOverallFinding {
  SATISFACTORY
  MINOR_ISSUES
  MAJOR_ISSUES
}

model VisitSubmission {
  id                   String                @id @default(uuid()) @db.Uuid
  clientSubmissionId   String                @unique @db.Uuid
  visitId              String                @db.Uuid
  projectId            String                @db.Uuid
  revisionNumber       Int                   @default(1)
  submittedByUserId    String                @db.Uuid
  fieldSessionId       String                @db.Uuid
  reporterName         String
  reporterRoleName     String
  // The frozen form answered (register: formSnapshotId + formHash).
  formSnapshotId       String                @db.Uuid
  formHash             String
  answersJson          Json
  overallFinding       VisitOverallFinding
  summaryText          String                @db.Text
  submissionGeotag     Json?
  geofenceStatus       GeofenceStatus?
  // Photo gaps and other non-blocking flags from validation.
  integrityFlags       Json                  @default("[]")
  // Device time of the officer's confirmation; receivedAt is when the server got it.
  confirmedAt          DateTime
  receivedAt           DateTime              @default(now())
  isLate               Boolean               @default(false)
  status               VisitSubmissionStatus @default(PENDING_APPROVAL)
  approvalChainVersion Int?
  currentApprovalStep  Int                   @default(0)
  approvedAt           DateTime?
  returnedAt           DateTime?
  returnedNotes        String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  visit        Visit              @relation(fields: [visitId], references: [id], onDelete: Cascade)
  project      Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  captures     FieldEvidenceLog[]
  siteLogItems SiteLogEntry[]
  comments     VisitComment[]

  @@index([visitId])
  @@index([projectId, status])
  @@map("visit_submissions")
}

model VisitComment {
  id           String   @id @default(uuid()) @db.Uuid
  visitId      String   @db.Uuid
  submissionId String?  @db.Uuid
  authorUserId String?  @db.Uuid
  authorName   String
  text         String   @db.Text
  createdAt    DateTime @default(now())

  visit      Visit            @relation(fields: [visitId], references: [id], onDelete: Cascade)
  submission VisitSubmission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)

  @@index([visitId, createdAt])
  @@map("visit_comments")
}

// Redesign R4c (D-R4.27, decision X): the officer's site log. Photos and voice notes name a
// registered capture (which carries the geotag); notes may carry their own. Never deleted; an author
// may hide a note (audited).
enum SiteLogKind {
  PHOTO
  VOICE
  NOTE
}

model SiteLogEntry {
  id                   String          @id @default(uuid()) @db.Uuid
  clientEntryId        String          @unique @db.Uuid
  projectId            String          @db.Uuid
  authorUserId         String          @db.Uuid
  authorName           String
  fieldSessionId       String          @db.Uuid
  kind                 SiteLogKind
  captureId            String?         @unique @db.Uuid
  text                 String?         @db.Text
  latitude             Float?
  longitude            Float?
  accuracyMeters       Float?
  geofenceStatus       GeofenceStatus?
  capturedAtDevice     DateTime
  attachedSubmissionId String?         @db.Uuid
  hiddenAt             DateTime?
  createdAt            DateTime        @default(now())

  project            Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  capture            FieldEvidenceLog? @relation(fields: [captureId], references: [id], onDelete: Restrict)
  attachedSubmission VisitSubmission?  @relation(fields: [attachedSubmissionId], references: [id], onDelete: SetNull)

  @@index([projectId, capturedAtDevice])
  @@index([authorUserId])
  @@map("site_log_entries")
}

// Redesign R4e (D-R4.31)
enum SprintVerificationOutcome {
  MET
  PARTLY_MET
  NOT_MET
}
