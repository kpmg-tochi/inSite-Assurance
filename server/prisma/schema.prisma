/// Tenant document types (seeded from DEFAULT_DOCUMENT_TYPES with every tenant).
model DocumentType {
  id                   String   @id @default(uuid()) @db.Uuid
  tenantId             String   @db.Uuid
  code                 String
  name                 String
  description          String?
  visibleToContractors Boolean  @default(false)
  requiresSignOff      Boolean  @default(false)
  signOffPermissionKey String?
  allowedMimeTypes     String[] @default([])
  isArchived           Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  documents ProjectDocument[]

  @@unique([tenantId, code])
  @@map("document_types")
}

model ProjectDocument {
  id                  String   @id @default(uuid()) @db.Uuid
  projectId           String   @db.Uuid
  documentTypeId      String   @db.Uuid
  title               String
  currentVersion      Int      @default(1)
  uploadedByUserId    String?  @db.Uuid
  projectContractorId String?  @db.Uuid
  linkedMilestoneId   String?  @db.Uuid
  isArchived          Boolean  @default(false)
  archivedReason      String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  project                Project                          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  documentType           DocumentType                     @relation(fields: [documentTypeId], references: [id], onDelete: Restrict)
  projectContractor      ProjectContractor?               @relation(fields: [projectContractorId], references: [id], onDelete: SetNull)
  linkedMilestone        ProjectContractMilestone?        @relation(fields: [linkedMilestoneId], references: [id], onDelete: SetNull)
  versions               ProjectDocumentVersion[]
  signOffs               ProjectDocumentSignOff[]
  kickoffAgendaFor       KickoffMeeting[]                 @relation("KickoffAgenda")
  kickoffMinutesFor      KickoffMeeting[]                 @relation("KickoffMinutes")
  // Phase 15
  completionCertificates CompletionCertificate[]          @relation("CompletionCertificateDocument")
  cocEvidenceFor         CompletionCertificateSignature[] @relation("CocSignatureEvidence")
  closurePacks           ClosurePackExport[]

  @@index([projectId, documentTypeId])
  @@index([projectContractorId])
  @@map("project_documents")
}

model ProjectDocumentVersion {
  id               String   @id @default(uuid()) @db.Uuid
  documentId       String   @db.Uuid
  version          Int
  objectKey        String   @unique
  mimeType         String
  byteSize         Int
  sha256           String
  uploadedByUserId String?  @db.Uuid
  uploadedAt       DateTime @default(now())
  note             String?

  document ProjectDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, version])
