generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// ENUMS
// ============================================================================

enum TenantStatus {
  ACTIVE
  SUSPENDED
  TRIAL
}

enum RoleSurface {
  WEB
  MOBILE
  BOTH
}

enum FieldPersonaType {
  INDEPENDENT_VERIFIER
  CONTRACTOR_EXECUTOR
  NONE
}

// How people in a mobile-capable role get onto a project (Phase 5).
enum RoleOnboardingMode {
  JOIN_CODE
  PROVISIONED_ACCOUNT
}

enum FieldSessionOrigin {
  JOIN_CODE
  PROVISIONED_ACCOUNT
}

enum OrganizationCategory {
  ADVISORY_MONITOR
  FINANCIER_LENDER
  CONTRACTOR
  CLIENT_OWNER
  GOVERNMENT_MDA
  OTHER
}

enum PermissionCategory {
  TENANT_ADMIN
  PORTFOLIO_PROJECTS
  BOQ_SCHEDULE
  MOBILIZATION_ASSURANCE
  FIELD_PRESENCE
  REPORT_APPROVALS
  FINANCIAL_IPC
  AUDIT_CLOSEOUT
}

enum ProfessionalLicenseType {
  QSRBN // Quantity Surveyors Registration Board of Nigeria
  COREN // Council for the Regulation of Engineering in Nigeria
  ARCON // Architects Registration Council of Nigeria
  CORBON // Council of Registered Builders of Nigeria
  ICAN // Institute of Chartered Accountants of Nigeria
  OTHER
}

// FieldPersonaType replaces static IndependenceTier enum on Role & FieldAgentSession

enum GeofenceMode {
  RADIAL
  LINEAR_CORRIDOR
  PERIMETER
}

// Server evaluation of a position against the project geofence and its tolerance band (Phase 6).
enum GeofenceStatus {
  INSIDE
  WITHIN_TOLERANCE
  OUTSIDE
}

// How organisation fields take input, per tenant (decision E).
enum OrgInputMode {
  FREE_TEXT
  DIRECTORY
  BOTH
}

// Project lifecycle (decision C). ACTIVE never returns to DRAFT.
enum ProjectStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

// Contractor model (decision D).
enum ContractorExecutionMode {
  SINGLE_CONTRACTOR
  MAIN_PLUS_SUBS_UNIFIED_IPC
  MULTI_PRIME_SEPARATE_IPC
}

enum ReportingCadence {
  DAILY
  WEEKLY
  BI_WEEKLY
  INSPECTION_ONLY
  // Phase 8
  MONTHLY
  CUSTOM_INTERVAL
}

enum PortfolioHealth {
  EVIDENCE_SUPPORTED
  EVIDENCE_PARTIAL
  EVIDENCE_CONFLICT
}

enum EvidenceStrengthRating {
  SUPPORTED
  PARTIALLY_SUPPORTED
  UNSUPPORTED
  CONTRADICTED
}

enum EvidenceLogStatus {
  REGISTERED
  FLAGGED_INTEGRITY
}

enum WorkdayReportStatus {
  STAGED_UNVERIFIED
  CONFIRMED
  // Phase 7 report approval
  PENDING_APPROVAL
  APPROVED_COMPLETED
  RETURNED_FOR_REVISION
}

// Phase 7: process engine
enum DocumentRequirementMode {
  REQUIRED_AT_CREATION
  OPTIONAL_AT_CREATION
  DISABLED
}

enum DisbursementMechanism {
  IPC_CLAIM_REQUIRED
  MILESTONE_DIRECT_DISBURSEMENT
}

enum StandardCategory {
  MATERIAL_QUALITY
  EXECUTION_METHOD
  TESTING_TOLERANCE
  SAFETY_ENVIRONMENT
  GENERAL_SPECIFICATION
}

enum NeedsAssessmentDocType {
  COMMUNITY_NEEDS_ASSESSMENT
  FEASIBILITY_STUDY
  ENVIRONMENTAL_SOCIAL_IMPACT
  STAKEHOLDER_REQUIREMENTS
  TECHNICAL_BASELINE
}

enum ApprovalChainType {
  REPORT
  DISBURSEMENT
}

enum ApprovalSubjectType {
  WORKDAY_REPORT
  VALUATION_REPORT
}

enum ApprovalDecision {
  APPROVE
  RETURN
  REJECT
}

enum BriefPersona {
  CONTRACTOR_EXECUTOR
  INDEPENDENT_VERIFIER
}

enum ReportQuerySource {
  MONITOR
  AI_OMISSION_CHECK
  AI_STANDARDS_CHECK
}

enum ValuationSource {
  IPC_CLAIM
  MILESTONE_DIRECT
}

enum WorkdayAiCheckStatus {
  PENDING
  RUNNING
  DONE
  SKIPPED
  FAILED
}

enum MediaType {
  SITE_PHOTO
  VOICE_NOTE
  WAYBILL_DOCUMENT
  LAB_CUBE_TEST_CERT
  MILL_CERTIFICATE
  BOQ_SPREADSHEET
  VALUATION_REPORT_PDF
  IDENTITY_DOCUMENT
  IDENTITY_SELFIE
  PROJECT_DOCUMENT
}

enum ConditionPrecedentStatus {
  PENDING
  SATISFIED
  WAIVED
  BREACHED
}

enum IpcClaimStatus {
  SUBMITTED
  AI_RECONCILED
  QUERIED_BY_MONITOR
  MONITOR_CERTIFIED
  LENDER_DECIDED
  REJECTED_WITHDRAWN
}

enum MonitorRecommendation {
  SUPPORT_FULL_RELEASE
  SUPPORT_WITH_HOLDBACK
  HOLD
}

enum LenderDecisionType {
  APPROVE_FULL
  APPROVE_WITH_HOLDBACK
  HOLD
}

enum QueryStatus {
  OPEN
  RESPONDED
  RESOLVED
}

enum AuditActorType {
  WEB_USER
  FIELD_AGENT
  AI_SYSTEM
  SYSTEM
}

enum ContractorAssuranceStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum AuditActionType {
  TENANT_CREATED
  TENANT_BRANDING_UPDATED
  ROLE_CREATED
  ROLE_UPDATED
  ROLE_DELETED
  USER_PROJECT_ASSIGNED
  PROJECT_CREATED
  BASELINE_UPDATED
  BOQ_UPLOADED
  JOIN_CODE_ISSUED
  FIELD_AGENT_JOINED
  FIELD_SESSION_STATUS_UPDATED
  CONTRACTOR_ASSURANCE_SUBMITTED
  CONTRACTOR_ASSURANCE_APPROVED
  CONTRACTOR_ASSURANCE_REJECTED
  EVIDENCE_EXTRACTED
  EVIDENCE_CONFIRMED
  EVIDENCE_FLAGGED_INTEGRITY
  IPC_SUBMITTED
  AI_RECONCILIATION_COMPLETED
  MONITOR_QUERY_RAISED
  CONTRACTOR_QUERY_RESPONDED
  VALUATION_REPORT_CERTIFIED
  LENDER_TRANCHE_DECIDED
  INCIDENT_REPORT_SUBMITTED
  INCIDENT_STATUS_UPDATED
  PUSH_TOKEN_REGISTERED
  WORKDAY_REPORT_SUBMITTED
  USER_CREATED
  USER_UPDATED
  USER_DEACTIVATED
  JOIN_CODE_ROTATED
  LOGIN_FAILED_LOCKOUT
  CP_STATUS_CHANGED
  CP_WAIVED
  MONITOR_QUERY_RESOLVED
  IPC_WITHDRAWN
  TRANCHE_DECISION_REVERSED
  TENANT_SETTINGS_UPDATED
  CAPTURE_REGISTERED
  CAPTURE_FLAGGED_INTEGRITY
  TELEMETRY_ANOMALY_SUMMARY
  WORKDAY_REPORTS_RELEASED
  DEVICE_KEY_REGISTERED
  REPORT_QUERY_RESOLVED
  MOBILE_USER_SIGNED_IN
  MOBILE_DEVICE_REVOKED
  ROLE_ONBOARDING_MODE_CHANGED
  ORGANIZATION_CREATED
  ORGANIZATION_UPDATED
  PROJECT_DRAFT_CREATED
  PROJECT_SETUP_STEP_SAVED
  PROJECT_ACTIVATED
  PROJECT_ARCHIVED
  PROJECT_CONTRACTOR_ADDED
  PROJECT_CONTRACTOR_REMOVED
  BOQ_REVISED
  PROJECT_DRAFT_DELETED
  WORKFLOW_TEMPLATE_SAVED
  PROJECT_PROCESS_CONFIG_UPDATED
  PROJECT_STANDARD_CREATED
  PROJECT_STANDARD_UPDATED
  PROJECT_STANDARD_DELETED
  NEEDS_ASSESSMENT_UPLOADED
  NEEDS_ASSESSMENT_DELETED
  WORKDAY_REPORT_APPROVED
  WORKDAY_REPORT_RETURNED
  STANDARDS_VIOLATION_FLAGGED
  APPROVAL_STEP_ACTIONED
  DIRECT_MILESTONE_VERIFIED
  // Phase 8
  REPORT_SUBMITTED_LATE
  REPORT_MISSED
  PARTICIPANT_PREREGISTERED
  PARTICIPANT_REMINDER_SENT
  ATTENDANCE_ALERT_RAISED
  ATTENDANCE_ALERT_RESOLVED
  MANUAL_CHECKIN_RECORDED
  REPORTING_OBLIGATION_EXCUSED
}

// Phase 8: cadence, mobilization, attendance, jobs and outbound messages
enum ReportingObligationStatus {
  PENDING
  SUBMITTED
  LATE
  MISSED
  EXCUSED
}

enum MobilizationStatus {
  INVITED
  REGISTERED_PENDING_ASSURANCE
  READY_FOR_MOBILIZATION
  MOBILIZED_ON_SITE
  NO_SHOW_FLAGGED
  WITHDRAWN
}

enum AttendanceAlertType {
  MOBILIZATION_NO_SHOW
  WORKDAY_MISSED_CHECKIN
  UNVERIFIED_AT_MOBILIZATION
}

enum AttendanceAlertStatus {
  OPEN
  ACKNOWLEDGED
  EXCUSED
  RESOLVED
}

enum JobRunStatus {
  RUNNING
  DONE
  FAILED
}

enum OutboundChannel {
  EMAIL
  SMS
  PUSH
}

enum OutboundMessageStatus {
  QUEUED
  SENT
  FAILED
}

enum MobileNotificationType {
  ASSURANCE_PENDING
  ASSURANCE_APPROVED
  ASSURANCE_REJECTED
  BACKLOG_REVIEW_REQUIRED
  REPORT_QUERY
  HOLD_POINT_ALERT
  MORNING_DELIVERABLE_READY
  SITE_GEOFENCE_WARNING
  REPORT_OVERDUE
}

enum NotificationActionType {
  NONE
  OPEN_REPORT_SUMMARY
  OPEN_WBS_CHAT
  OPEN_BACKLOG_REVIEW
  OPEN_ASSURANCE_WIZARD
}

// ============================================================================
// MODELS
// ============================================================================

// ============================================================================
// MULTI-TENANCY & RELATIONAL RBAC MODELS
// ============================================================================

model Tenant {
  id                             String         @id @default(uuid()) @db.Uuid
  name                           String
  slug                           String         @unique
  status                         TenantStatus   @default(ACTIVE)
  defaultCurrency                String         @default("NGN")
  timezone                       String         @default("Africa/Lagos")
  brandingConfig                 Json           @default("{}")
  // Display label and description per canonical EvidenceStrengthRating (decision B).
  evidenceRatingLabels           Json           @default("{}")
  // Phase 6 settings
  organizationInputMode          OrgInputMode   @default(BOTH)
  enabledGeofenceModes           GeofenceMode[] @default([RADIAL, LINEAR_CORRIDOR, PERIMETER])
  defaultGeofenceToleranceMeters Int            @default(100)
  createdAt                      DateTime       @default(now())
  updatedAt                      DateTime       @updatedAt

  organizations     Organization[]
  roles             Role[]
  users             User[]
  projects          Project[]
  auditLogs         AuditLog[]
  workflowTemplates WorkflowTemplate[]
  outboundMessages  OutboundMessage[]

  @@map("tenants")
}

model Permission {
  id          String             @id @default(uuid()) @db.Uuid
  key         String             @unique
  name        String
  description String
  category    PermissionCategory
  surface     RoleSurface        @default(WEB)
  createdAt   DateTime           @default(now())

  rolePermissions RolePermission[]

  @@index([category])
  @@map("permissions")
}

model Role {
  id                        String             @id @default(uuid()) @db.Uuid
  tenantId                  String             @db.Uuid
  name                      String
  code                      String
  codeSuffix                String?
  description               String?
  surface                   RoleSurface        @default(WEB)
  fieldPersonaType          FieldPersonaType   @default(NONE)
  assuranceWeight           Float              @default(1.0)
  requiresIdentityAssurance Boolean            @default(false)
  // Only meaningful for surface MOBILE or BOTH. PROVISIONED_ACCOUNT implies no identity assurance.
  onboardingMode            RoleOnboardingMode @default(JOIN_CODE)
  isSystemDefault           Boolean            @default(false)
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt

  tenant               Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rolePermissions      RolePermission[]
  users                User[]                       @relation("UserMainRole")
  mobileUsers          User[]                       @relation("UserMobileRole")
  joinCodes            ProjectJoinCode[]
  fieldSessions        FieldAgentSession[]
  expectedParticipants ExpectedProjectParticipant[]

  @@unique([tenantId, code])
  @@unique([tenantId, codeSuffix])
  @@index([tenantId, surface])
  @@map("roles")
}

model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  roleId       String   @db.Uuid
  permissionId String   @db.Uuid
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

// Organisation directory (Phase 6). Tags say which parts an organisation can play; the same firm
// may be a contractor on one project and a client on another. Name is unique per tenant
// (case-insensitive raw index from Phase 2).
model Organization {
  id                 String                 @id @default(uuid()) @db.Uuid
  tenantId           String                 @db.Uuid
  name               String
  categories         OrganizationCategory[] @default([])
  registrationNumber String?
  contactEmail       String?
  contactPhone       String?
  isArchived         Boolean                @default(false)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users              User[]
  monitoredProjects  Project[]           @relation("MonitorOrganization")
  lenderProjects     Project[]           @relation("LenderOrganization")
  projectContractors ProjectContractor[]

  @@index([tenantId])
}

model User {
  id                        String                   @id @default(uuid()) @db.Uuid
  tenantId                  String                   @db.Uuid
  email                     String                   @unique
  passwordHash              String
  fullName                  String
  isPlatformSuperAdmin      Boolean                  @default(false)
  roleId                    String                   @db.Uuid
  // Optional pre-provisioned mobile role (surface MOBILE or BOTH, mode PROVISIONED_ACCOUNT).
  mobileRoleId              String?                  @db.Uuid
  phoneNumber               String?
  organizationId            String                   @db.Uuid
  professionalLicenseType   ProfessionalLicenseType?
  professionalLicenseNumber String?
  isActive                  Boolean                  @default(true)
  mustChangePassword        Boolean                  @default(false)
  tokenVersion              Int                      @default(0)
  failedLoginCount          Int                      @default(0)
  lockedUntil               DateTime?
  lastLoginAt               DateTime?
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt

  tenant                  Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  notificationReads       WebNotificationRead[]
  role                    Role                         @relation("UserMainRole", fields: [roleId], references: [id], onDelete: Restrict)
  mobileRole              Role?                        @relation("UserMobileRole", fields: [mobileRoleId], references: [id], onDelete: SetNull)
  mobileDevices           MobileDevice[]
  fieldSessions           FieldAgentSession[]
  organization            Organization                 @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  projectAssignments      UserProjectAssignment[]
  certifiedReports        ValuationReport[]            @relation("CertifiedByMonitor")
  trancheDecisions        TrancheDecision[]            @relation("DecidedByLender")
  submittedIpcClaims      IpcClaim[]                   @relation("SubmittedIpcClaims")
  waivedConditions        ConditionPrecedent[]         @relation("WaivedConditions")
  raisedMonitorQueries    MonitorQuery[]               @relation("RaisedMonitorQueries")
  respondedMonitorQueries MonitorQuery[]               @relation("RespondedMonitorQueries")
  resolvedMonitorQueries  MonitorQuery[]               @relation("ResolvedMonitorQueries")
  pushTokens              PushToken[]
  raisedReportQueries     ReportQuery[]                @relation("RaisedReportQueries")
  approvalActions         ApprovalAction[]
  milestoneVerifications  MilestoneVerification[]
  expectedParticipations  ExpectedProjectParticipant[]

  @@index([tenantId])
  @@index([organizationId])
  @@index([roleId])
  @@index([mobileRoleId])
}

model UserProjectAssignment {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  projectId String   @db.Uuid
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([userId])
  @@index([projectId])
  @@map("user_project_assignments")
}

model Project {
  id                      String           @id @default(uuid()) @db.Uuid
  tenantId                String           @db.Uuid
  name                    String
  codePrefix              String // e.g., "LKK-402", unique per tenant
  // Lifecycle (Phase 6). Drafts are visible only in the wizard and the Drafts tab.
  status                  ProjectStatus    @default(DRAFT)
  // Per wizard step: { completedAt, completedByUserId }; plus team options.
  setupState              Json             @default("{}")
  createdByUserId         String?          @db.Uuid
  activatedAt             DateTime?
  activatedByUserId       String?          @db.Uuid
  archivedAt              DateTime?
  // Nullable while the project is a draft; activation requires them.
  stateLocation           String? // e.g., "Lagos State"
  lgaLocation             String?
  description             String?
  totalBudgetNgn          Decimal?         @db.Decimal(18, 2)
  disbursedToDateNgn      Decimal          @default(0) @db.Decimal(18, 2)
  certifiedProgressPct    Decimal          @default(0) @db.Decimal(5, 2)
  reportingCadence        ReportingCadence @default(WEEKLY)
  workdayStartTime        String           @default("08:00")
  workdayEndTime          String           @default("17:00")
  // IANA zone that defines a reporting day (one report per WBS item per day). Defaults to the tenant zone.
  timezone                String           @default("Africa/Lagos")
  geofenceMode            GeofenceMode?
  geofenceGeoJson         Json? // ProjectGeofence: radial, linear corridor or perimeter
  // Tolerance band outside the boundary; null uses Tenant.defaultGeofenceToleranceMeters.
  geofenceToleranceMeters Int?
  portfolioHealth         PortfolioHealth  @default(EVIDENCE_PARTIAL)

  // Phase 8: cadence. ISO weekdays (1 = Monday). reportDueTime null = workdayEndTime.
  workWeekDays                    Int[]   @default([1, 2, 3, 4, 5, 6])
  periodStartDayOfWeek            Int     @default(1)
  customIntervalDays              Int?
  reportDueTime                   String?
  reportGraceMinutes              Int     @default(0)
  cadenceAnchorDate               String?
  // Phase 8: mobilization reminder schedule (days before the planned date).
  mobilizationReminderOffsetsDays Int[]   @default([7, 3, 1])
  // A cadence change on a live project waits here until the next period starts
  // (ProjectReportingStep JSON; applied by brief-dispatch, read by cadenceSettingsForDate).
  pendingCadenceJson              Json?
  pendingCadenceEffectiveFrom     String?

  monitorOrganizationId   String?                  @db.Uuid
  lenderOrganizationId    String?                  @db.Uuid
  contractorExecutionMode ContractorExecutionMode?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  monitorOrganization Organization?       @relation("MonitorOrganization", fields: [monitorOrganizationId], references: [id])
  lenderOrganization  Organization?       @relation("LenderOrganization", fields: [lenderOrganizationId], references: [id])
  contractors         ProjectContractor[]
  boqRevisions        BoqRevision[]

  userAssignments        UserProjectAssignment[]
  joinCodes              ProjectJoinCode[]
  fieldSessions          FieldAgentSession[]
  tranches               FacilityTranche[]
  boqItems               BoqItem[]
  evidenceLogs           FieldEvidenceLog[]
  ipcClaims              IpcClaim[]
  auditLogs              AuditLog[]
  incidentReports        IncidentReport[]
  workdayReports         WorkdayReport[]
  telemetryPings         SiteTelemetryPing[]
  telemetryAnomalies     TelemetryAnomalyDaily[]
  morningBriefs          MorningDeliverableBrief[]
  notifications          MobileNotification[]
  reportQueries          ReportQuery[]
  wbsChatMessages        WbsChatMessage[]
  webNotifications       WebNotification[]
  // Phase 7
  processConfig          ProjectProcessConfig?
  approvalSteps          ApprovalStep[]
  approvalActions        ApprovalAction[]
  standards              ProjectStandardSpecification[]
  needsAssessments       ProjectNeedsAssessmentDocument[]
  valuationReports       ValuationReport[]
  milestoneVerifications MilestoneVerification[]
  // Phase 8
  reportingObligations   ReportingObligation[]
  expectedParticipants   ExpectedProjectParticipant[]
  attendanceAlerts       SiteAttendanceAlert[]
  outboundMessages       OutboundMessage[]

  @@unique([tenantId, codePrefix])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([portfolioHealth])
  @@index([monitorOrganizationId])
  @@index([lenderOrganizationId])
}

// A contractor on a project (Phase 6). In multi-prime each contractor owns its BOQ items and IPCs;
// in the unified model the main contractor submits IPCs and the others report from site only.
model ProjectContractor {
  id                      String    @id @default(uuid()) @db.Uuid
  projectId               String    @db.Uuid
  organizationId          String    @db.Uuid
  tradeCategory           String
  tradeCode               String
  isMainContractor        Boolean   @default(false)
  allocatedBudgetNgn      Decimal?  @db.Decimal(18, 2)
  allowFieldReporting     Boolean   @default(true)
  plannedMobilizationDate DateTime? @db.Date
  plannedCompletionDate   DateTime? @db.Date
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  project              Project                      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organization         Organization                 @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  boqItems             BoqItem[]
  joinCodes            ProjectJoinCode[]
  fieldSessions        FieldAgentSession[]
  ipcClaims            IpcClaim[]
  expectedParticipants ExpectedProjectParticipant[]

  @@unique([projectId, organizationId])
  @@unique([projectId, tradeCode])
  @@index([organizationId])
  @@map("project_contractors")
}

// One BOQ upload after activation (Phase 6). Uploads while the project is a draft need no revision.
model BoqRevision {
  id               String   @id @default(uuid()) @db.Uuid
  projectId        String   @db.Uuid
  revisionNumber   Int
  uploadedByUserId String   @db.Uuid
  reason           String
  itemCount        Int
  createdAt        DateTime @default(now())

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  boqItems BoqItem[]

  @@unique([projectId, revisionNumber])
  @@map("boq_revisions")
}

// One active code per (project, role, contractor): partial unique index
// "ProjectJoinCode_active_project_role_contractor_key" (raw SQL, Phase 6). Keep it when generating
// later migrations.
model ProjectJoinCode {
  id                  String    @id @default(uuid()) @db.Uuid
  projectId           String    @db.Uuid
  roleId              String    @db.Uuid
  // Set for contractor-executor codes on projects with contractors; binds sessions to the package.
  projectContractorId String?   @db.Uuid
  code                String    @unique // e.g., "LKK-402-INS-7K2QXM"
  isActive            Boolean   @default(true)
  expiresAt           DateTime?
  maxUses             Int?
  useCount            Int       @default(0)
  rotatedFromId       String?   @db.Uuid
  createdAt           DateTime  @default(now())

  project           Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  role              Role                @relation(fields: [roleId], references: [id], onDelete: Restrict)
  projectContractor ProjectContractor?  @relation(fields: [projectContractorId], references: [id], onDelete: Restrict)
  fieldSessions     FieldAgentSession[]

  @@index([projectId])
  @@index([roleId])
  @@index([projectContractorId])
}

// One unit of field provenance. Either a join-code session (joinCodeId set) or a provisioned
// account's session for one project on one device (userId set); a CHECK constraint keeps exactly
// one of the two.
model FieldAgentSession {
  id                     String             @id @default(uuid()) @db.Uuid
  projectId              String             @db.Uuid
  origin                 FieldSessionOrigin @default(JOIN_CODE)
  joinCodeId             String?            @db.Uuid
  userId                 String?            @db.Uuid
  mobileDeviceId         String?            @db.Uuid
  // Contractor package the session reports for (from its join code); null when project-wide.
  projectContractorId    String?            @db.Uuid
  roleId                 String             @db.Uuid
  roleNameSnapshot       String
  fieldPersonaType       FieldPersonaType   @default(INDEPENDENT_VERIFIER)
  assuranceWeight        Float              @default(1.0)
  agentFullName          String
  agentPhoneNumber       String
  agentPinHash           String?
  deviceId               String
  deviceModel            String?
  deviceOs               String?
  // Per-install Ed25519 public key (base64 raw). Captures, reports and pings are signed with it.
  devicePublicKey        String?
  devicePublicKeyAlg     String?
  devicePublicKeyId      String?
  devicePublicKeyAddedAt DateTime?
  isActive               Boolean            @default(true)
  revokedAt              DateTime?
  revokedByUserId        String?            @db.Uuid
  revokeReason           String?
  lastSyncAt             DateTime?
  createdAt              DateTime           @default(now())

  // Identity & Competence Assurance
  assuranceStatus    ContractorAssuranceStatus @default(APPROVED)
  idDocumentType     String?
  idDocumentUrl      String?
  selfieImageUrl     String?
  selfieLeftUrl      String?
  selfieRightUrl     String?
  livenessScore      Float?
  livenessPassed     Boolean                   @default(false)
  livenessMetadata   Json?
  corenLicenseNumber String?
  experienceSummary  String?
  reviewedByUserId   String?                   @db.Uuid
  reviewedAt         DateTime?
  rejectionReason    String?

  project              Project                      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  joinCode             ProjectJoinCode?             @relation(fields: [joinCodeId], references: [id], onDelete: Restrict)
  user                 User?                        @relation(fields: [userId], references: [id], onDelete: Restrict)
  mobileDevice         MobileDevice?                @relation(fields: [mobileDeviceId], references: [id], onDelete: Restrict)
  projectContractor    ProjectContractor?           @relation(fields: [projectContractorId], references: [id], onDelete: Restrict)
  role                 Role                         @relation(fields: [roleId], references: [id], onDelete: Restrict)
  evidenceLogs         FieldEvidenceLog[]
  incidentReports      IncidentReport[]
  workdayReports       WorkdayReport[]
  pushTokens           PushToken[]
  telemetryPings       SiteTelemetryPing[]
  notifications        MobileNotification[]
  wbsChatMessages      WbsChatMessage[]
  sentChatMessages     WbsChatMessage[]             @relation("ChatSenderSession")
  telemetryAnomalies   TelemetryAnomalyDaily[]
  notificationReads    MobileNotificationRead[]
  expectedParticipants ExpectedProjectParticipant[]
  attendanceAlerts     SiteAttendanceAlert[]

  @@unique([userId, projectId, deviceId])
  @@index([projectId, roleId])
  @@index([projectId, assuranceStatus])
  @@index([deviceId])
  @@index([userId])
  @@index([projectContractorId])
}

// A device a provisioned user has signed in on. Holds the per-install signing key (Phase 4) that
// is copied onto each of the user's sessions on this device. Revoking it blocks every project.
model MobileDevice {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @db.Uuid
  deviceId        String
  deviceModel     String?
  deviceOs        String?
  publicKey       String
  publicKeyAlg    String
  publicKeyId     String
  lastSeenAt      DateTime?
  revokedAt       DateTime?
  revokedByUserId String?   @db.Uuid
  revokeReason    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  fieldSessions FieldAgentSession[]
  pushTokens    PushToken[]

  @@unique([userId, deviceId])
  @@index([userId])
  @@map("mobile_devices")
}

model FacilityTranche {
  id                  String   @id @default(uuid()) @db.Uuid
  projectId           String   @db.Uuid
  trancheNumber       Int
  name                String // e.g., "Tranche 2 — Substructure & Box Culverts"
  allocatedAmountNgn  Decimal  @db.Decimal(18, 2)
  releasedAmountNgn   Decimal  @default(0) @db.Decimal(18, 2)
  targetCompletionPct Decimal  @db.Decimal(5, 2)
  isReleased          Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  project                Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  conditionsPrecedent    ConditionPrecedent[]
  boqItems               BoqItem[]
  ipcClaims              IpcClaim[]
  valuationReports       ValuationReport[]
  milestoneVerifications MilestoneVerification[]

  @@unique([projectId, trancheNumber])
}

model ConditionPrecedent {
  id                    String                   @id @default(uuid()) @db.Uuid
  trancheId             String                   @db.Uuid
  referenceCode         String // e.g., "CP-01"
  description           String
  isMandatoryForRelease Boolean                  @default(true)
  status                ConditionPrecedentStatus @default(PENDING)
  evidenceDocumentUrl   String?
  verifiedAt            DateTime?
  waivedByUserId        String?                  @db.Uuid
  waiverReason          String?
  statusChangedAt       DateTime?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  tranche      FacilityTranche @relation(fields: [trancheId], references: [id], onDelete: Cascade)
  waivedByUser User?           @relation("WaivedConditions", fields: [waivedByUserId], references: [id], onDelete: SetNull)

  @@index([trancheId])
}

model BoqItem {
  id                               String  @id @default(uuid()) @db.Uuid
  projectId                        String  @db.Uuid
  trancheId                        String? @db.Uuid
  aiSuggestedTrancheId             String? @db.Uuid
  trancheMappingConfirmedByMonitor Boolean @default(false)
  // Contractor package (Phase 6); required for every item in multi-prime before activation.
  projectContractorId              String? @db.Uuid
  // Last post-activation BOQ revision that changed this item.
  lastRevisionId                   String? @db.Uuid

  wbsCode         String // e.g., "02.03.1"
  section         String // e.g., "BILL NO. 2 — DRAINAGE & CULVERTS"
  description     String
  unit            String // e.g., "m3", "m", "tons", "bags", "item"
  totalQuantity   Decimal @db.Decimal(14, 3)
  rateNgn         Decimal @db.Decimal(18, 2)
  budgetedCostNgn Decimal @db.Decimal(18, 2)

  isHoldPoint            Boolean  @default(false)
  isScheduledToday       Boolean  @default(false)
  planningTier           String   @default("UNBLOCKED_POOL") // PLAN_A | FALLBACK_BACKLOG | UNBLOCKED_POOL
  dailyTargetQuantity    Decimal? @db.Decimal(14, 3)
  expectedDeliverable    String?
  holdPointInstruction   String?
  isOpaqueLumpSum        Boolean  @default(false)
  opacityWarningReason   String?
  cumulativeCertifiedPct Decimal  @default(0) @db.Decimal(5, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project              Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tranche              FacilityTranche?          @relation(fields: [trancheId], references: [id], onDelete: SetNull)
  projectContractor    ProjectContractor?        @relation(fields: [projectContractorId], references: [id], onDelete: SetNull)
  lastRevision         BoqRevision?              @relation(fields: [lastRevisionId], references: [id], onDelete: SetNull)
  evidenceLogs         FieldEvidenceLog[]
  ipcLineItems         IpcLineItem[]
  incidentReports      IncidentReport[]
  workdayReports       WorkdayReport[]
  morningBriefs        MorningDeliverableBrief[]
  reportQueries        ReportQuery[]
  wbsChatMessages      WbsChatMessage[]
  reportingObligations ReportingObligation[]

  @@unique([projectId, wbsCode])
  @@index([projectId, trancheId])
  @@index([projectId, projectContractorId])
}

// One capture: a photo, voice note or document with its hardware metadata (Phase 4).
// Evidence for reconciliation is a confirmed WorkdayReport plus the captures linked to it.
model FieldEvidenceLog {
  id               String            @id @default(uuid()) @db.Uuid
  projectId        String            @db.Uuid
  boqItemId        String?           @db.Uuid
  fieldSessionId   String            @db.Uuid
  clientCaptureId  String            @unique @db.Uuid
  workdayReportId  String?           @db.Uuid
  reporterRoleId   String?           @db.Uuid
  reporterRoleName String            @default("Field Reporter")
  fieldPersonaType FieldPersonaType  @default(INDEPENDENT_VERIFIER)
  assuranceWeight  Float             @default(1.0)
  status           EvidenceLogStatus @default(REGISTERED)
  caption          String?

  // GPS at capture. Location fields are null when the device had no fix.
  locationAvailable      Boolean
  latitude               Float?
  longitude              Float?
  altitudeMeters         Float?
  gpsAccuracyMeters      Float?
  isMockLocation         Boolean         @default(false)
  // Server-evaluated. null = no fix or evaluation failed; never the client's claim.
  // isWithinGeofence = INSIDE or WITHIN_TOLERANCE (Phase 6), kept for older readers.
  isWithinGeofence       Boolean?
  geofenceStatus         GeofenceStatus?
  // Distance outside the boundary in metres (0 when inside); null when not evaluated.
  distanceOutsideMeters  Float?
  chainageKm             Float?
  chainageLabel          String?
  corridorOffsetMeters   Float?
  distanceFromSiteMeters Float?

  // Device orientation and provenance
  devicePitchDeg                 Float?
  deviceRollDeg                  Float?
  deviceAzimuthDeg               Float?
  deviceSignature                String?
  devicePublicKeyId              String?
  // true = valid, false = invalid, null = unsigned or no key registered
  signatureVerified              Boolean?
  clientSha256                   String?
  serverSha256                   String?
  integrityPassed                Boolean  @default(true)
  integrityFlags                 Json     @default("[]")
  // Phase 5 Step 8: re-submitted under a new session after the session that captured it ended.
  // The original keeps its own session; this row is never merged into it.
  resubmittedFromClientCaptureId String?  @db.Uuid
  resubmittedFromEvidenceLogId   String?  @db.Uuid

  // Voice notes: NOT_APPLICABLE | PENDING | DONE | FAILED
  transcriptionStatus String  @default("NOT_APPLICABLE")
  transcript          String?
  transcriptionEngine String?

  capturedAtDevice DateTime
  syncedAtServer   DateTime @default(now())

  project          Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  boqItem          BoqItem?          @relation(fields: [boqItemId], references: [id], onDelete: SetNull)
  fieldSession     FieldAgentSession @relation(fields: [fieldSessionId], references: [id], onDelete: Restrict)
  workdayReport    WorkdayReport?    @relation(fields: [workdayReportId], references: [id], onDelete: SetNull)
  mediaAttachments EvidenceMedia[]
  chatMessages     WbsChatMessage[]

  @@index([projectId, status])
  @@index([projectId, boqItemId])
  @@index([workdayReportId])
  @@index([fieldSessionId, capturedAtDevice])
}

model EvidenceMedia {
  id              String    @id @default(uuid()) @db.Uuid
  evidenceLogId   String    @db.Uuid
  // Denormalised so duplicate screening is an indexed lookup within one tenant.
  tenantId        String    @db.Uuid
  projectId       String    @db.Uuid
  mediaType       MediaType
  objectKey       String
  mimeType        String
  byteSize        Int
  // Computed by the server from the stored bytes.
  sha256FileHash  String
  // 64-bit difference hash (16 hex chars), computed by the server from image bytes.
  perceptualHash  String?
  durationSeconds Float?
  createdAt       DateTime  @default(now())

  evidenceLog FieldEvidenceLog @relation(fields: [evidenceLogId], references: [id], onDelete: Cascade)

  @@index([evidenceLogId])
  @@index([tenantId, sha256FileHash])
  @@index([tenantId, mediaType])
}

model IpcClaim {
  id                    String         @id @default(uuid()) @db.Uuid
  projectId             String         @db.Uuid
  trancheId             String         @db.Uuid
  // The contractor that submitted it (Phase 6). IPC numbers run per contractor.
  projectContractorId   String?        @db.Uuid
  ipcNumber             Int
  periodStart           DateTime
  periodEnd             DateTime
  contractorCoverNote   String?
  totalClaimedAmountNgn Decimal        @db.Decimal(18, 2)
  totalCertifiedNgn     Decimal?       @db.Decimal(18, 2)
  status                IpcClaimStatus @default(SUBMITTED)
  aiExecutiveSummary    String?
  submittedByUserId     String         @db.Uuid
  // AZURE_OPENAI or RULES_ENGINE; null until reconciliation has run.
  ratingEngine          String?
  ratingEngineDetail    String?
  reconciledAt          DateTime?
  submittedAt           DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  project             Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tranche             FacilityTranche         @relation(fields: [trancheId], references: [id], onDelete: Restrict)
  projectContractor   ProjectContractor?      @relation(fields: [projectContractorId], references: [id], onDelete: Restrict)
  submittedByUser     User                    @relation("SubmittedIpcClaims", fields: [submittedByUserId], references: [id])
  lineItems           IpcLineItem[]
  supportingDocuments IpcSupportingDocument[]
  valuationReports    ValuationReport[]

  @@unique([projectId, projectContractorId, ipcNumber])
  @@index([projectId, status])
  @@index([trancheId, status])
  @@index([projectContractorId])
}

model IpcLineItem {
  id         String @id @default(uuid()) @db.Uuid
  ipcClaimId String @db.Uuid
  boqItemId  String @db.Uuid

  previousCertifiedPct Decimal @default(0) @db.Decimal(5, 2)
  contractorClaimedPct Decimal @db.Decimal(5, 2)
  contractorClaimedNgn Decimal @db.Decimal(18, 2)
  contractorRemarks    String?

  // AI Auditor Co-Pilot Output (Never legally certifies completion %)
  aiEvidenceRating             EvidenceStrengthRating @default(UNSUPPORTED)
  aiRationale                  String?
  visitPlannerFlag             Boolean                @default(false)
  visitPlannerReason           String?
  missingHoldPointFlag         Boolean                @default(false)
  highestCorroboratingRoleName String?
  highestCorroboratingWeight   Float?
  corroboratingEvidenceLogIds  Json                   @default("[]")
  evidenceQuantityTotal        Decimal?               @db.Decimal(18, 3)
  evidenceCoveragePct          Decimal?               @db.Decimal(9, 2)
  ratingEngine                 String?
  ruleCapsApplied              Json                   @default("[]")

  // Human Monitor (QS / COREN) Certified Valuation
  monitorCertifiedPct Decimal? @db.Decimal(5, 2)
  monitorCertifiedNgn Decimal? @db.Decimal(18, 2)
  monitorRemarks      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ipcClaim IpcClaim       @relation(fields: [ipcClaimId], references: [id], onDelete: Cascade)
  boqItem  BoqItem        @relation(fields: [boqItemId], references: [id], onDelete: Restrict)
  queries  MonitorQuery[]

  @@unique([ipcClaimId, boqItemId])
}

model IpcSupportingDocument {
  id         String    @id @default(uuid()) @db.Uuid
  ipcClaimId String    @db.Uuid
  boqItemId  String?   @db.Uuid
  title      String
  mediaType  MediaType
  objectKey  String
  fileUrl    String?
  uploadedAt DateTime  @default(now())

  ipcClaim IpcClaim @relation(fields: [ipcClaimId], references: [id], onDelete: Cascade)

  @@index([ipcClaimId])
}

model MonitorQuery {
  id                          String      @id @default(uuid()) @db.Uuid
  ipcLineItemId               String      @db.Uuid
  status                      QueryStatus @default(OPEN)
  queryReason                 String
  requestedProofTypes         Json        @default("[]")
  contractorResponseText      String?
  revisedClaimedCumulativePct Decimal?    @db.Decimal(5, 2)
  attachedDocumentsJson       Json        @default("[]")
  raisedByUserId              String?     @db.Uuid
  respondedByUserId           String?     @db.Uuid
  resolvedByUserId            String?     @db.Uuid
  resolutionNote              String?
  createdAt                   DateTime    @default(now())
  respondedAt                 DateTime?
  resolvedAt                  DateTime?

  ipcLineItem     IpcLineItem @relation(fields: [ipcLineItemId], references: [id], onDelete: Cascade)
  raisedByUser    User?       @relation("RaisedMonitorQueries", fields: [raisedByUserId], references: [id], onDelete: SetNull)
  respondedByUser User?       @relation("RespondedMonitorQueries", fields: [respondedByUserId], references: [id], onDelete: SetNull)
  resolvedByUser  User?       @relation("ResolvedMonitorQueries", fields: [resolvedByUserId], references: [id], onDelete: SetNull)

  @@index([ipcLineItemId, status])
}

// One certification. Phase 7: either of an IPC (source IPC_CLAIM, ipcClaimId set) or of a direct
// milestone verification (source MILESTONE_DIRECT, ipcClaimId null). A CHECK constraint
// (ValuationReport_source_ipc_check, raw SQL) keeps ipcClaimId set exactly when source = IPC_CLAIM.
model ValuationReport {
  id                            String                  @id @default(uuid()) @db.Uuid
  projectId                     String                  @db.Uuid
  trancheId                     String                  @db.Uuid
  source                        ValuationSource         @default(IPC_CLAIM)
  ipcClaimId                    String?                 @db.Uuid
  milestoneVerificationId       String?                 @unique @db.Uuid
  // Disbursement chain this valuation runs on (null for valuations made before chains existed).
  approvalChainVersion          Int?
  // Step order being waited on; 0 once the valuation was returned.
  currentApprovalStep           Int                     @default(0)
  revisionNumber                Int                     @default(1)
  certifiedByUserId             String                  @db.Uuid
  trancheRecommendation         MonitorRecommendation
  recommendedReleaseAmountNgn   Decimal                 @db.Decimal(18, 2)
  recommendedHoldbackAmountNgn  Decimal                 @db.Decimal(18, 2)
  executiveCertificationSummary String
  // Snapshots copied from the certifying User at certification time, never from the request.
  certifierFullName             String
  certifierLicenseType          ProfessionalLicenseType
  certifierLicenseNumber        String
  totalClaimedNgn               Decimal                 @db.Decimal(18, 2)
  totalCertifiedNgn             Decimal                 @db.Decimal(18, 2)
  reportPdfObjectKey            String?
  reportPdfUrl                  String?
  certifiedAt                   DateTime                @default(now())
  supersededAt                  DateTime?

  project               Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tranche               FacilityTranche        @relation(fields: [trancheId], references: [id], onDelete: Restrict)
  ipcClaim              IpcClaim?              @relation(fields: [ipcClaimId], references: [id], onDelete: Cascade)
  milestoneVerification MilestoneVerification? @relation(fields: [milestoneVerificationId], references: [id], onDelete: Restrict)
  certifiedByUser       User                   @relation("CertifiedByMonitor", fields: [certifiedByUserId], references: [id])
  trancheDecisions      TrancheDecision[]

  @@unique([ipcClaimId, revisionNumber])
  @@index([projectId, source])
  @@index([trancheId])
}

// A verifier's direct milestone verification (Phase 7, no contractor claim). The system claim is
// built from evidence; lineVerificationsJson holds the per-item figures the server computed.
model MilestoneVerification {
  id                    String   @id @default(uuid()) @db.Uuid
  projectId             String   @db.Uuid
  trancheId             String   @db.Uuid
  verifiedByUserId      String   @db.Uuid
  verificationSummary   String   @db.Text
  lineVerificationsJson Json     @default("[]")
  createdAt             DateTime @default(now())

  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tranche         FacilityTranche  @relation(fields: [trancheId], references: [id], onDelete: Restrict)
  verifiedByUser  User             @relation(fields: [verifiedByUserId], references: [id])
  valuationReport ValuationReport?

  @@index([projectId, trancheId])
  @@map("milestone_verifications")
}

model TrancheDecision {
  id                            String             @id @default(uuid()) @db.Uuid
  valuationReportId             String             @db.Uuid
  decidedByUserId               String             @db.Uuid
  decision                      LenderDecisionType
  approvedDisbursementAmountNgn Decimal            @db.Decimal(18, 2)
  heldBackAmountNgn             Decimal            @db.Decimal(18, 2)
  creditCommitteeReference      String?
  approverNotes                 String?
  // Set on a reversal record: the decision it cancels. Reversal amounts are negative.
  reversesDecisionId            String?            @unique @db.Uuid
  cpSnapshotJson                Json               @default("[]")
  decidedAt                     DateTime           @default(now())

  valuationReport  ValuationReport  @relation(fields: [valuationReportId], references: [id], onDelete: Cascade)
  decidedByUser    User             @relation("DecidedByLender", fields: [decidedByUserId], references: [id])
  reversesDecision TrancheDecision? @relation("DecisionReversal", fields: [reversesDecisionId], references: [id], onDelete: Restrict)
  reversedBy       TrancheDecision? @relation("DecisionReversal")

  @@index([valuationReportId])
}

model AuditLog {
  id               String          @id @default(uuid()) @db.Uuid
  tenantId         String          @db.Uuid
  projectId        String?         @db.Uuid
  seq              BigInt
  actorType        AuditActorType
  actorId          String
  actorDisplayName String
  action           AuditActionType
  summaryText      String
  payload          Json
  previousHash     String
  entryHash        String          @unique
  createdAt        DateTime        @default(now())

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([tenantId, projectId, seq])
  @@index([projectId, seq])
  @@index([tenantId, seq])
}

model PushToken {
  id             String   @id @default(uuid()) @db.Uuid
  deviceToken    String
  // One phone can hold a provisioned account and several join-code sessions (Phase 5), so a token
  // is unique per owner: "session:<id>", "user:<id>" (mobile account) or "web:<id>".
  ownerKey       String
  devicePlatform String // ANDROID, IOS, WEB
  appVersion     String?
  sessionId      String?  @db.Uuid
  userId         String?  @db.Uuid
  // Set when a provisioned account registers from the mobile app; revoking the device removes it.
  mobileDeviceId String?  @db.Uuid
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  session      FieldAgentSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user         User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  mobileDevice MobileDevice?      @relation(fields: [mobileDeviceId], references: [id], onDelete: Cascade)

  @@unique([deviceToken, ownerKey])
  @@index([sessionId])
  @@index([userId])
  @@map("push_tokens")
}

model IncidentReport {
  id                          String    @id @default(uuid()) @db.Uuid
  clientIncidentId            String    @unique @db.Uuid
  projectId                   String    @db.Uuid
  reporterSessionId           String    @db.Uuid
  wbsItemId                   String?   @db.Uuid
  category                    String // WHISTLEBLOWING, SITE_EMERGENCY, CRITICAL_DELAY, MATERIAL_FAILURE
  severity                    String    @default("HIGH") // CRITICAL, HIGH, MEDIUM, LOW
  title                       String
  description                 String    @db.Text
  isConfidentialWhistleblower Boolean   @default(false)
  status                      String    @default("OPEN") // OPEN, UNDER_REVIEW, ACTION_TAKEN, DISMISSED
  photoEvidenceUrls           String[]
  voiceNoteUrl                String?
  deviceGpsCoordinates        Json?
  createdAt                   DateTime  @default(now())
  resolvedAt                  DateTime?

  project         Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reporterSession FieldAgentSession @relation(fields: [reporterSessionId], references: [id], onDelete: Cascade)
  boqItem         BoqItem?          @relation(fields: [wbsItemId], references: [id], onDelete: SetNull)

  @@index([projectId, category])
  @@index([projectId, status])
  @@map("incident_reports")
}

model WorkdayReport {
  id                        String               @id @default(uuid()) @db.Uuid
  clientReportId            String               @unique @db.Uuid
  projectId                 String               @db.Uuid
  reporterSessionId         String               @db.Uuid
  wbsItemId                 String               @db.Uuid
  workdayDate               String // YYYY-MM-DD in the reporter's time zone
  reporterTimezone          String
  status                    WorkdayReportStatus  @default(STAGED_UNVERIFIED)
  revisionNumber            Int                  @default(1)
  parentReportId            String?              @db.Uuid
  resolvedQueryId           String?              @db.Uuid
  summaryText               String               @db.Text
  reportedQuantity          Decimal              @default(0) @db.Decimal(14, 3)
  unitOfMeasure             String
  isHoldPointClaimed        Boolean              @default(false)
  delaysOrBlockers          String?              @db.Text
  // Text-only notes from the WBS thread: [{ id, text, capturedAt }]
  textNotes                 Json                 @default("[]")
  submissionGeotag          Json?
  // Server evaluation of the submission position (also inside submissionGeotag).
  geofenceStatus            GeofenceStatus?
  deviceSignature           String?
  signatureVerified         Boolean?
  // Location and integrity notes shown as badges, e.g. LOW_GPS_ACCURACY, OUTSIDE_PROJECT_GEOFENCE.
  integrityFlags            Json                 @default("[]")
  aiCheckStatus             WorkdayAiCheckStatus @default(PENDING)
  aiCheckEngine             String?
  aiReasoning               String?              @db.Text
  humanConfirmedAt          DateTime?
  releasedAt                DateTime?
  // Phase 7
  reporterPersonaType       FieldPersonaType     @default(INDEPENDENT_VERIFIER)
  // null until checked, or when the check could not decide ("not checked").
  standardsCompliancePassed Boolean?
  standardsViolationsJson   Json                 @default("[]")
  approvalChainVersion      Int?
  // Step order being waited on while PENDING_APPROVAL; 0 otherwise.
  currentApprovalStep       Int                  @default(0)
  approvedCompletedAt       DateTime?
  // Phase 8: the reporting period (workdayDate stays the day the work was done).
  reportingPeriodStart      String
  reportingPeriodEnd        String
  dueAt                     DateTime
  isLateSubmission          Boolean              @default(false)
  lateByMinutes             Int?
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt

  project         Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reporterSession FieldAgentSession     @relation(fields: [reporterSessionId], references: [id], onDelete: Cascade)
  boqItem         BoqItem               @relation(fields: [wbsItemId], references: [id], onDelete: Cascade)
  parentReport    WorkdayReport?        @relation("WorkdayReportRevisions", fields: [parentReportId], references: [id], onDelete: SetNull)
  revisions       WorkdayReport[]       @relation("WorkdayReportRevisions")
  queries         ReportQuery[]
  chatMessages    WbsChatMessage[]
  captures        FieldEvidenceLog[]
  obligations     ReportingObligation[]

  @@index([projectId, wbsItemId, workdayDate])
  @@index([projectId, reportingPeriodStart])
  @@index([projectId, status])
  @@index([aiCheckStatus, updatedAt])
  @@index([parentReportId])
  @@map("workday_reports")
}

model SiteTelemetryPing {
  id                    String          @id @default(uuid()) @db.Uuid
  clientPingId          String          @unique @db.Uuid
  projectId             String          @db.Uuid
  fieldSessionId        String          @db.Uuid
  wbsItemId             String?         @db.Uuid
  latitude              Float
  longitude             Float
  accuracyMeters        Float?
  altitudeMeters        Float?
  isMocked              Boolean         @default(false)
  isWithinGeofence      Boolean?
  geofenceStatus        GeofenceStatus?
  distanceOutsideMeters Float?
  chainageLabel         String?
  distanceMeters        Float?
  pingSource            String          @default("FOREGROUND_PRESENCE") // FOREGROUND_PRESENCE | CAPTURE | REPORT_SUBMISSION | MANUAL_CHECKIN
  deviceSignature       String?
  signatureVerified     Boolean?
  capturedAtDevice      DateTime
  syncedAtServer        DateTime        @default(now())

  project      Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fieldSession FieldAgentSession @relation(fields: [fieldSessionId], references: [id], onDelete: Cascade)

  @@index([projectId, capturedAtDevice])
  @@index([fieldSessionId, capturedAtDevice])
  @@map("site_telemetry_pings")
}

// One row per session, calendar day and anomaly type. Replaces one audit entry per ping.
model TelemetryAnomalyDaily {
  id             String   @id @default(uuid()) @db.Uuid
  projectId      String   @db.Uuid
  fieldSessionId String   @db.Uuid
  day            String // YYYY-MM-DD in the tenant time zone
  anomalyType    String // MOCK_LOCATION | OUTSIDE_GEOFENCE
  pingCount      Int      @default(0)
  firstSeenAt    DateTime
  lastSeenAt     DateTime

  project      Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fieldSession FieldAgentSession @relation(fields: [fieldSessionId], references: [id], onDelete: Cascade)

  @@unique([fieldSessionId, day, anomalyType])
  @@index([projectId, day])
  @@map("telemetry_anomaly_daily")
}

model MorningDeliverableBrief {
  id                   String       @id @default(uuid()) @db.Uuid
  projectId            String       @db.Uuid
  boqItemId            String       @db.Uuid
  workdayDate          String // YYYY-MM-DD
  planningTier         String       @default("PLAN_A")
  headline             String
  expectedDeliverable  String       @db.Text
  reportingChecklist   Json         @default("[]")
  dailyTargetQuantity  Decimal?     @db.Decimal(14, 3)
  generatedByAi        Boolean      @default(false)
  // Phase 7: one brief per persona; an inspector's brief never tells them to build anything.
  targetPersona        BriefPersona @default(CONTRACTOR_EXECUTOR)
  appliedStandardsJson Json         @default("[]")
  // Phase 8: one brief per item, persona and reporting period. workdayDate is the dispatch day.
  reportingPeriodStart String
  reportingPeriodEnd   String
  dueAt                DateTime
  createdAt            DateTime     @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  boqItem BoqItem @relation(fields: [boqItemId], references: [id], onDelete: Cascade)

  @@unique([projectId, boqItemId, reportingPeriodStart, targetPersona])
  @@index([projectId, workdayDate])
  @@index([projectId, reportingPeriodStart])
  @@map("morning_deliverable_briefs")
}

model MobileNotification {
  id                  String                 @id @default(uuid()) @db.Uuid
  projectId           String                 @db.Uuid
  fieldSessionId      String?                @db.Uuid
  type                MobileNotificationType
  actionType          NotificationActionType @default(NONE)
  requiresAction      Boolean                @default(false)
  title               String
  message             String                 @db.Text
  metadata            Json                   @default("{}")
  createdAt           DateTime               @default(now())
  // Phase 5 Step 8: set when anyone completes the action this notification asks for; it then shows
  // as done for every session. See notifications/notificationActions.ts for what completes what.
  actionedAt          DateTime?
  actionedBySessionId String?                @db.Uuid
  actionedByUserId    String?                @db.Uuid
  actionedByName      String?

  project      Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fieldSession FieldAgentSession?       @relation(fields: [fieldSessionId], references: [id], onDelete: Cascade)
  reads        MobileNotificationRead[]

  @@index([projectId, createdAt])
  @@index([fieldSessionId, createdAt])
  @@map("mobile_notifications")
}

// Read state per field session (Phase 2 carry-over). A broadcast notification (fieldSessionId null)
// read by one field user stays unread for everyone else.
model MobileNotificationRead {
  notificationId String   @db.Uuid
  fieldSessionId String   @db.Uuid
  readAt         DateTime @default(now())

  notification MobileNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  fieldSession FieldAgentSession  @relation(fields: [fieldSessionId], references: [id], onDelete: Cascade)

  @@id([notificationId, fieldSessionId])
  @@index([fieldSessionId])
  @@map("mobile_notification_reads")
}

model ReportQuery {
  id                         String            @id @default(uuid()) @db.Uuid
  projectId                  String            @db.Uuid
  boqItemId                  String            @db.Uuid
  workdayReportId            String?           @db.Uuid
  ipcLineItemId              String?           @db.Uuid
  raisedByUserId             String?           @db.Uuid
  source                     ReportQuerySource @default(MONITOR)
  status                     String            @default("OPEN") // OPEN | RESUBMITTED | RESOLVED
  monitorComment             String?           @db.Text
  aiOmissionPayload          Json?
  // AI_STANDARDS_CHECK: StandardsViolationItem[] (Phase 7)
  standardsViolationsPayload Json?
  createdAt                  DateTime          @default(now())
  respondedAt                DateTime?
  resolvedAt                 DateTime?

  project       Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  boqItem       BoqItem          @relation(fields: [boqItemId], references: [id], onDelete: Cascade)
  workdayReport WorkdayReport?   @relation(fields: [workdayReportId], references: [id], onDelete: SetNull)
  raisedByUser  User?            @relation("RaisedReportQueries", fields: [raisedByUserId], references: [id], onDelete: SetNull)
  chatMessages  WbsChatMessage[]

  @@index([projectId, boqItemId, status])
  @@index([workdayReportId])
  @@map("report_queries")
}

model WbsChatMessage {
  id              String   @id @default(uuid()) @db.Uuid
  projectId       String   @db.Uuid
  boqItemId       String   @db.Uuid
  workdayReportId String?  @db.Uuid
  reportQueryId   String?  @db.Uuid
  // The field session whose thread this is (target of queries); not necessarily the sender.
  fieldSessionId  String?  @db.Uuid
  clientMessageId String?  @unique @db.Uuid
  senderSessionId String?  @db.Uuid
  senderUserId    String?  @db.Uuid
  captureId       String?  @db.Uuid
  senderName      String
  senderRole      String // AI_CO_PILOT | MONITOR | ENGINEER | INSPECTOR
  messageType     String // AI_QUERY | MONITOR_QUERY | QUERY_RESPONSE | TEXT_COMMENT | PHOTO | VOICE_NOTE
  textContent     String?  @db.Text
  latitude        Float?
  longitude       Float?
  chainageLabel   String?
  createdAt       DateTime @default(now())

  project       Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  boqItem       BoqItem            @relation(fields: [boqItemId], references: [id], onDelete: Cascade)
  workdayReport WorkdayReport?     @relation(fields: [workdayReportId], references: [id], onDelete: SetNull)
  reportQuery   ReportQuery?       @relation(fields: [reportQueryId], references: [id], onDelete: SetNull)
  fieldSession  FieldAgentSession? @relation(fields: [fieldSessionId], references: [id], onDelete: SetNull)
  senderSession FieldAgentSession? @relation("ChatSenderSession", fields: [senderSessionId], references: [id], onDelete: SetNull)
  capture       FieldEvidenceLog?  @relation(fields: [captureId], references: [id], onDelete: SetNull)

  @@index([projectId, boqItemId, createdAt])
  @@index([reportQueryId])
  @@map("wbs_chat_messages")
}

model WebNotification {
  id                  String   @id @default(uuid()) @db.Uuid
  projectId           String   @db.Uuid
  targetPermissionKey String   @default("reports:view_all")
  targetRoleId        String?  @db.Uuid
  category            String // REPORT_RESUBMITTED | CONFLICT_FLAG | CONTRACTOR_ONBOARDING | TRANCHE_DISBURSEMENT | MONITOR_QUERY | AI_OMISSION_FLAG
  title               String
  description         String   @db.Text
  actionUrl           String?
  metadata            Json     @default("{}")
  createdAt           DateTime @default(now())

  project Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reads   WebNotificationRead[]

  @@index([projectId, targetPermissionKey, createdAt])
  @@map("web_notifications")
}

model WebNotificationRead {
  notificationId String   @db.Uuid
  userId         String   @db.Uuid
  readAt         DateTime @default(now())

  notification WebNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([notificationId, userId])
  @@index([userId])
  @@map("web_notification_reads")
}

// ============================================================================
// PHASE 7: PROCESS ENGINE, STANDARDS, APPROVAL CHAINS
// ============================================================================

// A tenant's reusable process. Applying it copies configJson into the project's own rows, so
// later template edits never change a project (WorkflowTemplateConfigSchema validates it).
model WorkflowTemplate {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  name        String
  description String?
  isDefault   Boolean  @default(false)
  configJson  Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("workflow_templates")
}

model ProjectProcessConfig {
  id                                String                  @id @default(uuid()) @db.Uuid
  projectId                         String                  @unique @db.Uuid
  // Provenance only: the template the settings were copied from.
  workflowTemplateId                String?                 @db.Uuid
  needsAssessmentMode               DocumentRequirementMode @default(OPTIONAL_AT_CREATION)
  standardsSpecificationMode        DocumentRequirementMode @default(OPTIONAL_AT_CREATION)
  disbursementMechanism             DisbursementMechanism   @default(IPC_CLAIM_REQUIRED)
  enableTranchesAndCps              Boolean                 @default(true)
  enableHoldPoints                  Boolean                 @default(true)
  allowContractorFieldReporting     Boolean                 @default(true)
  enableContractorIdentityAssurance Boolean                 @default(true)
  enableAiOmissionCheck             Boolean                 @default(true)
  enableAiStandardsCheck            Boolean                 @default(true)
  requireReportApproval             Boolean                 @default(false)
  enableHandoverModule              Boolean                 @default(false)
  enableRetentionModule             Boolean                 @default(false)
  createdAt                         DateTime                @default(now())
  updatedAt                         DateTime                @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_process_configs")
}

// One step of a project's approval chain. Chains are never edited in place: a change writes a new
// version (and deactivates the old one), and items in flight keep the version they started on.
model ApprovalStep {
  id                    String            @id @default(uuid()) @db.Uuid
  projectId             String            @db.Uuid
  chainType             ApprovalChainType
  version               Int
  stepOrder             Int
  label                 String
  requiredPermissionKey String
  requiredRoleId        String?           @db.Uuid
  minAmountThresholdNgn Decimal?          @db.Decimal(18, 2)
  isSystemStep          Boolean           @default(false)
  isActive              Boolean           @default(true)
  createdAt             DateTime          @default(now())

  project Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actions ApprovalAction[]

  @@unique([projectId, chainType, version, stepOrder])
  @@index([projectId, chainType, isActive])
  @@map("approval_steps")
}

model ApprovalAction {
  id          String              @id @default(uuid()) @db.Uuid
  projectId   String              @db.Uuid
  chainType   ApprovalChainType
  subjectType ApprovalSubjectType
  subjectId   String              @db.Uuid
  stepId      String              @db.Uuid
  stepOrder   Int
  decision    ApprovalDecision
  actorUserId String              @db.Uuid
  notes       String?
  createdAt   DateTime            @default(now())

  project Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  step    ApprovalStep @relation(fields: [stepId], references: [id], onDelete: Restrict)
  actor   User         @relation(fields: [actorUserId], references: [id])

  @@index([subjectType, subjectId, createdAt])
  @@index([projectId, chainType])
  @@map("approval_actions")
}

model ProjectStandardSpecification {
  id                 String           @id @default(uuid()) @db.Uuid
  projectId          String           @db.Uuid
  code               String
  title              String
  category           StandardCategory
  specificationText  String           @db.Text
  documentObjectKey  String?
  // Empty = the whole project; otherwise WBS codes, each covering the codes below it.
  applicableWbsCodes Json             @default("[]")
  isMandatory        Boolean          @default(true)
  createdByUserId    String           @db.Uuid
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, code])
  @@map("project_standard_specifications")
}

model ProjectNeedsAssessmentDocument {
  id                   String                 @id @default(uuid()) @db.Uuid
  projectId            String                 @db.Uuid
  title                String
  documentType         NeedsAssessmentDocType
  objectKey            String
  mimeType             String
  byteSize             Int
  // Null until summarised; never invented when no AI provider is available.
  extractedSummaryText String?                @db.Text
  keyFindingsJson      Json                   @default("[]")
  // NOT_REQUESTED | PENDING | DONE
  summaryStatus        String                 @default("NOT_REQUESTED")
  summaryEngine        String?
  uploadedByUserId     String                 @db.Uuid
  uploadedAt           DateTime               @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_needs_assessment_documents")
}

// ============================================================================
// PHASE 8: CADENCE, MOBILIZATION, ATTENDANCE, JOBS, OUTBOUND MESSAGES
// ============================================================================

// One report owed for one WBS item and reporting period by one reporter scope:
// "contractor:<projectContractorId>", "contractor:project" (no packages) or "verifier".
model ReportingObligation {
  id              String                    @id @default(uuid()) @db.Uuid
  projectId       String                    @db.Uuid
  boqItemId       String                    @db.Uuid
  reporterScope   String
  periodStart     String
  periodEnd       String
  dueAt           DateTime
  // dueAt plus the project's grace when the obligation was created.
  lateAfter       DateTime
  status          ReportingObligationStatus @default(PENDING)
  workdayReportId String?                   @db.Uuid
  alertedAt       DateTime?
  excusedNote     String?
  excusedByUserId String?                   @db.Uuid
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  boqItem       BoqItem        @relation(fields: [boqItemId], references: [id], onDelete: Cascade)
  workdayReport WorkdayReport? @relation(fields: [workdayReportId], references: [id], onDelete: SetNull)

  @@unique([projectId, boqItemId, reporterScope, periodStart])
  @@index([projectId, periodStart])
  @@index([status, lateAfter])
  @@map("reporting_obligations")
}

// Someone expected on a project (mobilization roster). Linked to an account for provisioned roles,
// or described by name plus email or phone for join-code roles.
model ExpectedProjectParticipant {
  id                          String             @id @default(uuid()) @db.Uuid
  projectId                   String             @db.Uuid
  projectContractorId         String?            @db.Uuid
  roleId                      String             @db.Uuid
  userId                      String?            @db.Uuid
  fullName                    String
  email                       String?
  phoneNumber                 String?
  plannedMobilizationDate     String // YYYY-MM-DD in the project time zone
  // HH:MM; null = the project's workday start time.
  expectedCheckInTime         String?
  checkInGraceMinutes         Int                @default(120)
  // Used only when usesProjectReminderSchedule is false.
  reminderOffsetsDays         Int[]              @default([7, 3, 1])
  usesProjectReminderSchedule Boolean            @default(true)
  lastReminderSentAt          DateTime?
  linkedFieldSessionId        String?            @db.Uuid
  mobilizationStatus          MobilizationStatus @default(INVITED)
  createdByUserId             String             @db.Uuid
  createdAt                   DateTime           @default(now())
  updatedAt                   DateTime           @updatedAt

  project            Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectContractor  ProjectContractor?    @relation(fields: [projectContractorId], references: [id], onDelete: SetNull)
  role               Role                  @relation(fields: [roleId], references: [id], onDelete: Restrict)
  user               User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  linkedFieldSession FieldAgentSession?    @relation(fields: [linkedFieldSessionId], references: [id], onDelete: SetNull)
  alerts             SiteAttendanceAlert[]

  @@index([projectId, mobilizationStatus])
  @@index([projectId, plannedMobilizationDate])
  @@index([userId])
  @@map("expected_project_participants")
}

model SiteAttendanceAlert {
  id               String                @id @default(uuid()) @db.Uuid
  projectId        String                @db.Uuid
  participantId    String?               @db.Uuid
  fieldSessionId   String?               @db.Uuid
  workdayDate      String
  alertType        AttendanceAlertType
  status           AttendanceAlertStatus @default(OPEN)
  resolvedByUserId String?               @db.Uuid
  resolutionNotes  String?
  resolvedAt       DateTime?
  createdAt        DateTime              @default(now())

  project      Project                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  participant  ExpectedProjectParticipant? @relation(fields: [participantId], references: [id], onDelete: Cascade)
  fieldSession FieldAgentSession?          @relation(fields: [fieldSessionId], references: [id], onDelete: SetNull)

  @@unique([projectId, participantId, workdayDate, alertType])
  @@index([projectId, status])
  @@map("site_attendance_alerts")
}

// One claimed unit of scheduled work. The unique (jobName, scopeKey) makes each unit run once
// across API instances; a FAILED unit may be claimed again.
model JobRun {
  id         String       @id @default(uuid()) @db.Uuid
  jobName    String
  scopeKey   String
  startedAt  DateTime     @default(now())
  finishedAt DateTime?
  status     JobRunStatus @default(RUNNING)
  detail     String?

  @@unique([jobName, scopeKey])
  @@index([jobName, startedAt])
  @@map("job_runs")
}

model OutboundMessage {
  id                String                @id @default(uuid()) @db.Uuid
  tenantId          String                @db.Uuid
  projectId         String?               @db.Uuid
  channel           OutboundChannel
  toAddress         String
  templateKey       String
  payloadJson       Json                  @default("{}")
  status            OutboundMessageStatus @default(QUEUED)
  providerMessageId String?
  error             String?
  attempts          Int                   @default(0)
  nextAttemptAt     DateTime              @default(now())
  createdAt         DateTime              @default(now())
  sentAt            DateTime?

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([tenantId, createdAt])
  @@index([toAddress, createdAt])
  @@map("outbound_messages")
}
