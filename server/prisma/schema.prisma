  createdAt         DateTime @default(now())

  meeting KickoffMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
  @@map("kickoff_invitees")
}

model ContractorDefaultCase {
  id                  String             @id @default(uuid()) @db.Uuid
  projectId           String             @db.Uuid
  projectContractorId String             @db.Uuid
  trigger             DefaultCaseTrigger
  milestoneId         String?            @db.Uuid
  status              DefaultCaseStatus  @default(OPEN)
  summary             String
  outcomeNotes        String?
  newDueDate          String?
  // Set when a cure period ended without a cure and the case came back for a decision.
