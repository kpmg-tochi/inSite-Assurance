# InSite Assurance mobile app. Copy to mobile/.env
# Required for release builds and must be https://. In development the app falls back to the
# Expo dev server's LAN host on port 4000.
EXPO_PUBLIC_API_BASE_URL=

# Demo mode compiles the persona switcher, skip-verification and project catalog into the app.
# Keep false for any build that real users will see.
EXPO_PUBLIC_DEMO_MODE=false
