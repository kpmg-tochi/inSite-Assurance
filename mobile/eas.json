{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "node": "24.22.3",
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "development",
        "APP_BUNDLE_ID": "com.kpmg.insiteassurance.mobile",
        "EXPO_PUBLIC_DEMO_MODE": "false"
      }
    },
    "preview": {
      "node": "24.22.3",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "preview",
        "APP_BUNDLE_ID": "com.kpmg.insiteassurance.mobile",
        "EXPO_PUBLIC_DEMO_MODE": "false",
        "EXPO_PUBLIC_API_BASE_URL": "https://SET-STAGING-API-HOST.invalid/api/v1"
      }
    },
    "demo": {
      "extends": "preview",
      "env": {
        "APP_VARIANT": "demo",
        "APP_BUNDLE_ID": "com.kpmg.insiteassurance.mobile",
        "EXPO_PUBLIC_DEMO_MODE": "true",
        "EXPO_PUBLIC_API_BASE_URL": "https://SET-DEMO-API-HOST.invalid/api/v1"
      }
    },
    "production": {
      "node": "24.22.3",
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "production",
        "APP_BUNDLE_ID": "com.kpmg.insiteassurance.mobile",
        "EXPO_PUBLIC_DEMO_MODE": "false",
        "EXPO_PUBLIC_API_BASE_URL": "https://SET-PRODUCTION-API-HOST.invalid/api/v1"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
