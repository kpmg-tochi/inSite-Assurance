{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "@playwright/mcp@latest"
      ],
      "env": {}
    },
    "maestro": {
      "type": "stdio",
      "command": "maestro",
      "args": [
        "mcp"
      ],
      "env": {}
    }
  }
}