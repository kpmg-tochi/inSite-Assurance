# Web portal. Copy to web/.env
VITE_API_DEV_URL=http://localhost:4000/api/v1
VITE_API_PROD_URL=/api/v1

# Demo mode compiles demo accounts, the account switcher and demo shortcuts into the bundle.
# Keep false for any build that real users will see.
VITE_DEMO_MODE=false

# Platform name shown in the app (white-labelling).
APPLICATION_NAME="InSite Assurance"
